                    padding: 5mm 5mm 5mm 5mm !important;
                    width: 100% !important;
                    max-width: 100% !important;
                    left: 0 !important;
                    display: block !important;
                    position: relative !important;

    }

            .wrapper-tabla-scroll {
                    height: auto !important;
                    max-height: none !important;
                    overflow: visible !important;

    }


    }

    /* Contenedor principal de la alerta */
    .swal-custom-popup {
        background-color: #ffffff !important;
        border: 2px solid #2c3e50 !important;
        border-radius: 8px !important;
        font-family: 'Century Gothic', sans-serif !important;
        padding-bottom: 15px !important;
    }

    /* Título de la alerta */
    .swal-custom-title {
        color: #2c3e50 !important;
        font-size: 0.60rem !important;
        font-weight: bold !important;
        border-bottom: 2px solid #2c3e50 !important;
        margin-bottom: 15px !important;
        padding-bottom: 10px !important;
    }

    /* Nuevo estilo para la etiqueta del input */
    .swal-custom-label {
        font-family: 'Century Gothic', sans-serif !important;
        color: #7f8c8d !important; /* Color gris suave */
        font-size: 0.85rem !important; /* Tamaño adecuado */
        font-weight: normal !important; /* Fuente normal */
        margin-top: 15px !important; /* Espacio respecto al título */
        margin-bottom: 5px !important; /* Espacio respecto al input */
        text-align: left !important;
        display: block !important;
        margin-left: 5% !important; /* Para alinear con el input que tiene width: 90% */
    }

    /* Campo de entrada (estilo tu .valor-texto) */
    .swal-custom-input {
        background-color: #f8f9fa !important;
        border: 1px solid #ccd1d9 !important;
        padding: 8px 12px !important;
        border-radius: 4px !important;
        color: #2c3e50 !important;
        width: 90% !important;
        margin: 10px auto !important;
    }

    /* Contenedor de botones (estilo tu .panel-acciones-ficha) */
    .swal-custom-actions {
        background-color: #2c3e50 !important;
        border-radius: 6px !important;
        padding: 5px !important;
        margin-top: 15px !important;
    }

    /* Botones dentro de la alerta */
    .swal-custom-btn {
        background: none !important;
        border: none !important;
        color: #ffffff !important;
        font-family: 'Century Gothic', sans-serif !important;
        font-size: 0.8rem !important;
        cursor: pointer !important;
        padding: 5px 20px !important;
    }

        .swal-custom-btn:hover {
            background-color: #34495e !important;
        }
</style>

