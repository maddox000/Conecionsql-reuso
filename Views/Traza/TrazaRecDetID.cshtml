                    width: auto;

    }

            .header-impresion-bloque {
                    display: block !important;
                    float: left;
                    margin-top: 0px;
                    margin-bottom: 15px;

    }

            .logo-print-img-real {
                    height: 52px;
                    width: auto;

    }


    /* RESTAURADO: Panel de Firmas exclusivo para la Impresión */
            .bloque-firmas-impresion {
                    display: flex !important;
                    justify-content: space-between !important;
                    margin-top: 40px !important;
                    width: 100% !important;
                    page-break-inside: avoid;

    }

            .espacio-firma-print {
                    border-top: 1px dashed #7f8c8d !important;
                    text-align: center !important;
                    padding-top: 6px !important;
                    width: 42% !important;
                    font-family: 'Century Gothic', Arial, sans-serif !important;
                    font-size: 0.8rem !important;
                    color: #2c3e50 !important;
                    font-weight: bold !important;

    }


    /* Pie de página dinámico */
            body::after {
                    content: "Generado el: " attr(data-fecha-hora) "                                                                                                                Página 1 de 1";
                    position: fixed;
                    bottom: 5mm;
                    left: 5mm;
                    right: 5mm;
                    font-size: 0.75rem;
                    color: #7f8c8d;
                    border-top: 1px solid #dee2e6;
                    padding-top: 5px;
                    font-family: 'Century Gothic', Arial, sans-serif;
                    display: block;

    }

            aside, .sidebar, .main-sidebar, #sidebar-wrapper, .left-side, .menu-lateral,
            nav, .navbar, header, .main-header, .panel-acciones-ficha, .main-footer, footer {
                    display: none !important;

    }

            body, .content-wrapper, .container, .container-fluid, .main-content, #wrapper, main {
