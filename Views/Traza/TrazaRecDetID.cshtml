<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    var tituloOriginalDocumento = document.title;

    $(document).ready(function () {
        let idEtiqueta = "@idInicial";
        if (idEtiqueta && idEtiqueta !== "") {
            cargarFichaEtiqueta(idEtiqueta);
        }
    });

    function prepararAtributosImpresion() {
        let ahora = new Date();
        let dia = String(ahora.getDate()).padStart(2, '0');
        let mes = String(ahora.getMonth() + 1).padStart(2, '0');
        let anio = ahora.getFullYear();
        let horas = String(ahora.getHours()).padStart(2, '0');
        let minutos = String(ahora.getMinutes()).padStart(2, '0');

        let fechaHoraFormateada = `${dia}/${mes}/${anio} ${horas}:${minutos} hs.`;
        document.body.setAttribute('data-fecha-hora', fechaHoraFormateada);
    }

    function ejecutarImpresion() {
        prepararAtributosImpresion();
        document.title = tituloOriginalDocumento;
        window.print();
    }

    function guardarAPdf() {
        let nombreSugerido = "Trazabilidad_Etiqueta_" + ($('#lblTituloId').text() || "Ficha");

        Swal.fire({
            title: '<div style="display: flex; align-items: center; justify-content: flex-start; gap: 10px;">' +
                   '<img src="/IMG/Baxen - Logo.ico" style="width: 40px; height: 40px; margin-right: -5px; margin-top: -5px;">' +
                   '<span style="font-family: \'Century Gothic\', sans-serif; font-size: 1.00rem; color: #2c3e50; font-weight: normal;">Trazabilidad</span>' +
                   '</div>',
            input: 'text',
            inputLabel: 'Guardar en archivo PDF',
            inputValue: nombreSugerido,
            showCancelButton: true,
            confirmButtonText: '<i class="fas fa-save" style="margin-right:8px;"></i> Guardar',
            cancelButtonText: '<i class="fas fa-times" style="margin-right:8px;"></i> Cancelar',
            buttonsStyling: false,
            customClass: {
                popup: 'swal-custom-popup',
                input: 'swal-custom-input',
                inputLabel: 'swal-custom-label',
                actions: 'swal-custom-actions',
                confirmButton: 'swal-custom-btn',
                cancelButton: 'swal-custom-btn'
            }
        }).then((result) => {
            // Solo procedemos si el usuario hizo clic en "Guardar"
            if (result.isConfirmed) {
                let nombreArchivo = result.value || nombreSugerido;

                // PREPARACIÓN: Se cierra la modal automáticamente antes de este punto
                prepararAtributosImpresion();
                document.title = nombreArchivo.trim();

                // Retraso mínimo para asegurar que el DOM se haya limpiado de la modal
                setTimeout(() => {
                    window.print();

                    // Restaurar título después de imprimir
                    setTimeout(() => {
                        document.title = tituloOriginalDocumento;
                    }, 500);
                }, 300);
            }
        });
    }

    function cargarFichaEtiqueta(idTarget) {
        $.post("@Url.Action("ObtenerFicha", "TrazaRecDetID")", { id: idTarget }, function (response) {
            if (response.error) {
                alert(response.mensaje);
                return;
            }

            let d = response.data.ficha;
            let historial = response.data.historial;

            const formatFechaCorta = (s) => {
                if (!s) return '-';
                let date = new Date(s);
                if (isNaN(date.getTime())) return '-';
                let day = String(date.getDate()).padStart(2, '0');
                let month = String(date.getMonth() + 1).padStart(2, '0');
                let year = date.getFullYear();
                return `${day}/${month}/${year}`;
            };

            const formatHoraCorta = (s) => {
                if (!s) return '';
                if (s.includes('T') || s.includes(' ')) {
                    let tiempo = s.includes('T') ? s.split('T')[1] : s.split(' ')[1];
                    let fragmentos = tiempo.split(':');
                    return `${fragmentos[0]}:${fragmentos[1]}`;
                }
                let partes = s.split(':');
                if (partes.length >= 2) {
                    if(partes[0].length > 2) partes[0] = partes[0].slice(-2);
                    return `${partes[0]}:${partes[1]}`;
                }
                return s;
            };

            $('#lblTituloId').text(d.CodigoEtiqueta);
            $('#lblCodProducto').text(d.CodigoProducto || '-');
            $('#lblDenomMaterial').text(d.DenominacionMaterial || '-');
            $('#lblLoteMaterial').text(d.LoteMaterial || '-');
            $('#lblTipoMaterial').text(d.TipoMaterial || '-');
            $('#lblTareaRealizar').text(d.TareaRealizar || '-');
            $('#lblTareaActual').text(d.TareaActual || '-');
            $('#lblVencEsterilidad').text(formatFechaCorta(d.VencimientoEsterilidad));
            $('#lblRevision').text(d.Revision || '-');
            $('#lblContenido').text(d.Contenido || '-');
            $('#lblCantidad').text(d.Cantidad || '-');
            $('#lblSectorOrigen').text(d.SectorOrigen || '-');
            $('#lblSectorDestino').text(d.SectorDestino || '-');
            $('#lblCodReuso').text(d.CodigoReuso || '-');
            $('#lblLoteReuso').text(d.LoteReuso || '-');
            $('#lblUbicacionActualDen').text(d.UbicacionActualDen || '-');
            $('#lblUbicacionActualId').text(d.UbicacionActualId !== null ? d.UbicacionActualId : '-');
            $('#lblCantUsos').text(d.CantidadUsos !== null ? d.CantidadUsos : '-');
            $('#lblFechaRegistroReuso').text(formatFechaCorta(d.FechaRegistroReuso));
            $('#lblVencProducto').text(formatFechaCorta(d.VencimientoProducto));
            $('#lblNumeroIngreso').text(d.NumeroIngreso || '-');
            $('#lblRemitoFila1').text(d.Remito || '-');
            $('#lblProveedor').text(d.Proveedor || '-');
            $('#lblProfesional').text(d.Profesional || '-');
            $('#lblPaciente').text(d.Paciente || '-');

            let fechaStr = formatFechaCorta(d.FechaProcedimiento);
            let horaStr = formatHoraCorta(d.HoraProcedimiento);
            $('#lblFechaHoraProc').text(fechaStr !== '-' ? `${fechaStr} ${horaStr}`.trim() : '-');

            let htmlHistorial = "";
            if (historial && historial.length > 0) {
                historial.sort((a, b) => parseInt(a.EtapaNum) - parseInt(b.EtapaNum));

                historial.forEach(h => {
                    let fMov = formatFechaCorta(h.Fecha);
                    let hMov = formatHoraCorta(h.Hora);
                    let datetimeConcat = fMov !== '-' ? `${fMov} ${hMov}`.trim() : '-';

                    let nroProcedimientoLimpio = "-";
                    if (h.Detalle) {
                        let match = h.Detalle.match(/Nro\s*Proc:\s*([^\s-]+)/i);
                        if (match && match[1]) {
                            nroProcedimientoLimpio = match[1].trim();
                        }
                    }

                    htmlHistorial += `<tr>
                        <td style="font-weight: 600; text-align: left; color: #2c3e50;">${h.EtapaDen}</td>
                        
                        <td style="text-align: center; font-family: monospace; font-size: 0.85rem; cursor:pointer;" ondblclick="abrirProcedimiento('${h.EtapaDen}','${nroProcedimientoLimpio}')">${nroProcedimientoLimpio}</td>
                        <td style="text-align: center;">${datetimeConcat}</td>
                        <td style="text-align: left;">${h.Operador || '-'}</td>
                    </tr>`;
                });
            } else {
                htmlHistorial = '<tr><td colspan="4" style="color: #7f8c8d; padding: 20px; text-align: center;">No se registran movimientos en el ciclo de vida para este código de etiqueta.</td></tr>';
            }
            $('.tbodyHistorialClase').html(htmlHistorial);

        }).fail(function () {
            alert("Error de red al intentar conectar la base de datos.");
        });
    }

    //doble click para procedimientos
    function abrirProcedimiento(etapa, id) {

        etapa = (etapa || '').toUpperCase().trim();
        id = (id || '').trim();

        if (!id || id === '-') return;

        switch (etapa) {

        case 'RECEPCIÓN':
        case 'RECEPCION':
        window.location.href = '/Busquedas/ConsultaRecepcion/' + id;
        break;

        case 'LAVADO':
        window.location.href = '/TbProLavBusqueda/ConsultaLavado?tbProLavId=' + id;
        break;

        case 'ACONDICIONADO':
        window.location.href = '/AcoBusqueda/ConsultaAcondicionado?tbProAcoId=' + id;
        break;

        case 'PROCESO':
        window.location.href = '/TbProBusqueda/VerProceso?tbProId=' + id;
        break;

        case 'ENTREGA':
        window.location.href = '/EntBusqueda/ConsultaEntrega?tbEntId=' + id;
        break;
        }

    }

</script>