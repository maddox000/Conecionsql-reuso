<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    var tituloOriginalDocumento = document.title;

    $(document).ready(function () {
        let idReuso = "@idInicial";
        if (idReuso && idReuso !== "") {
            cargarFichaReuso(idReuso);
        }
    });

    function prepararAtributosImpresion() {
        let ahora = new Date();
        let dia = String(ahora.getDate()).padStart(2, '0');
        let mes = String(ahora.getMonth() + 1).padStart(2, '0');
        let anio = ahora.getFullYear();
        let horas = String(ahora.getHours()).padStart(2, '0');
        let minutos = String(ahora.getMinutes()).padStart(2, '0');

        let fechaHoraFormateada = `${dia}/${mes}/${anio} ${horas}:${minutos} hs.`;
        document.body.setAttribute('data-fecha-hora', fechaHoraFormateada);
    }

    function ejecutarImpresion() {
        prepararAtributosImpresion();
        document.title = tituloOriginalDocumento;
        window.print();
    }

    function guardarAPdf() {
        let nombreSugerido = "Trazabilidad_Reuso_" + ($('#lblTituloId').text() || "Ficha");

        Swal.fire({
            title: '<div style="display: flex; align-items: center; justify-content: flex-start; gap: 10px;">' +
                   '<img src="/IMG/Baxen - Logo.ico" style="width: 40px; height: 40px; margin-right: -5px; margin-top: -5px;">' +
                   '<span style="font-family: \'Century Gothic\', sans-serif; font-size: 1.00rem; color: #2c3e50; font-weight: normal;">Trazabilidad</span>' +
                   '</div>',
            input: 'text',
            inputLabel: 'Guardar en archivo PDF',
            inputValue: nombreSugerido,
            showCancelButton: true,
            confirmButtonText: '<i class="fas fa-save" style="margin-right:8px;"></i> Guardar',
            cancelButtonText: '<i class="fas fa-times" style="margin-right:8px;"></i> Cancelar',
            buttonsStyling: false,
            customClass: {
                popup: 'swal-custom-popup',
                input: 'swal-custom-input',
                inputLabel: 'swal-custom-label',
                actions: 'swal-custom-actions',
                confirmButton: 'swal-custom-btn',
                cancelButton: 'swal-custom-btn'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                let nombreArchivo = result.value || nombreSugerido;
                prepararAtributosImpresion();
                document.title = nombreArchivo.trim();

                setTimeout(() => {
                    window.print();
                    setTimeout(() => {
                        document.title = tituloOriginalDocumento;
                    }, 500);
                }, 300);
            }
        });
    }

    function cargarFichaReuso(idTarget) {
        $.post("@Url.Action("ObtenerFicha", "TrazaReuID")", { id: idTarget }, function (response) {
            if (response.error) {
                alert(response.mensaje);
                return;
            }

            let d = response.data.ficha;
            let historial = response.data.historial;

            // Formateadores requeridos
            const formatFechaCorta = (s) => {
                if (!s) return '-';
                let date = new Date(s);
                if (isNaN(date.getTime())) return '-';
                let day = String(date.getDate()).padStart(2, '0');
                let month = String(date.getMonth() + 1).padStart(2, '0');
                let year = date.getFullYear();
                return `${day}/${month}/${year}`;
            };

            const formatHoraCorta = (s) => {
                if (!s) return '';
                if (s.includes('T') || s.includes(' ')) {
                    let tiempo = s.includes('T') ? s.split('T')[1] : s.split(' ')[1];
                    let fragmentos = tiempo.split(':');
                    return `${fragmentos[0]}:${fragmentos[1]}`;
                }
                let partes = s.split(':');
                if (partes.length >= 2) {
                    if(partes[0].length > 2) partes[0] = partes[0].slice(-2);
                    return `${partes[0]}:${partes[1]}`;
                }
                return s;
            };

            // Título general
            $('#lblTituloId').text(d.TB_REU_ID_FORM || '-');

            // Sección: Datos del material
            $('#lblDenomMaterial').text(d.TB_REU_MAT_DEN || '-');
            $('#lblTipoMaterial').text(d.TB_REU_MAT_MTI_DEN || '-');
            $('#lblMarca').text(d.TB_REU_MAT_MCA || '-');
            $('#lblFabricante').text(d.TB_REU_MAT_FAB || '-');
            $('#lblObservaciones').text(d.TB_REU_TXT_1 || d.TB_REU_MEM_1 || '-');

            // Sección: Datos de codificación
            $('#lblSector').text(d.TB_REU_SEC_DEN || '-');
            $('#lblOperador').text(d.TB_REU_PER_NOM || '-');
            $('#lblProfesional').text(d.TB_REU_PER_CAR_DEN || '-');
            $('#lblIdentificador').text(d.TB_REU_MAT_IDE || '-');

            let fReg = formatFechaCorta(d.TB_REU_FEC);
            let hReg = formatHoraCorta(d.TB_REU_HOR_INI);
            $('#lblFechaHoraReg').text(fReg !== '-' ? `${fReg} ${hReg}`.trim() : '-');

            // Sección: Datos de reúso
            $('#lblEtapaActual').text(d.TB_REU_EST_ING_DEN || '-');
            $('#lblFechaEtapa').text(formatFechaCorta(d.TB_REU_EST_ING_FEC));
            $('#lblReusosActuales').text(d.TB_REU_MAT_OPC_REG !== null ? d.TB_REU_MAT_OPC_REG : '-');

            // Checkbox Baja de Stock
            let isBaja = (d.TB_REU_BSTO === true || d.TB_REU_BSTO === 1 || d.TB_REU_BSTO === "1" || d.TB_REU_BSTO === "True");
            $('#chkBajaStock').prop('checked', isBaja);

            $('#lblFechaBaja').text(formatFechaCorta(d.TB_REU_BSTO_FEC));
            $('#lblMotivoBaja').text(d.TB_REU_BSTO_BCREU_DEN || '-');
            $('#lblResponsableBaja').text(d.TB_REU_BSTO_PER_NOM || '-');

            // Llenado de Historial
            let htmlHistorial = "";
            if (historial && historial.length > 0) {
                // ELIMINADA: La línea que ordenaba por EtapaNum (historial.sort(...))
                // Ahora se respeta el ORDER BY cronológico de tu base de datos (SP).

                historial.forEach(h => {
                    let fMov = formatFechaCorta(h.Fecha);
                    let hMov = formatHoraCorta(h.Hora);
                    let datetimeConcat = fMov !== '-' ? `${fMov} ${hMov}`.trim() : '-';

                    let nroProcedimientoLimpio = "-";
                    if (h.Detalle) {
                        let match = h.Detalle.match(/Nro\s*Proc:\s*([^\s-]+)/i);
                        if (match && match[1]) {
                            nroProcedimientoLimpio = match[1].trim();
                        }
                    } else if(h.NroProcedimiento){
                        nroProcedimientoLimpio = h.NroProcedimiento;
                    }

                    htmlHistorial += `<tr>
                        <td style="font-weight: 600; text-align: left; color: #2c3e50;">${h.EtapaDen || '-'}</td>
                        <td style="text-align: center; font-family: monospace; font-size: 0.85rem;">${nroProcedimientoLimpio}</td>
                        <td style="text-align: center;">${datetimeConcat}</td>
                        <td style="text-align: left;">${h.Operador || '-'}</td>
                    </tr>`;
                });
            } else {
                htmlHistorial = '<tr><td colspan="4" style="color: #7f8c8d; padding: 20px; text-align: center;">No se registran movimientos en el ciclo de vida para este código de reúso.</td></tr>';
            }
            $('.tbodyHistorialClase').html(htmlHistorial);

        }).fail(function () {
            alert("Error de red al intentar conectar la base de datos.");
        });
    }
</script>