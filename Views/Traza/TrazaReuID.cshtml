@{
    var idInicial = ViewBag.IdReu;
}

<link rel="stylesheet" href="~/css/estadisticas-customs.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<style>
    :root {
        /* ========================================================================= */
        /* PARAMETROS DE CONTROL MANUAL: Modificá estos valores para las alturas     */
        /* ========================================================================= */
        --altura-columna-principal: 715px; /* Controla la Columna 1 en Pantalla */
        --altura-columnas-secundarias: 420px; /* Controla las Columnas 2, 3 y 4 en Pantalla */
    }

    /* El contenedor del logo solo se activa en la hoja de impresión */
    .header-impresion-bloque {
        display: none;
    }

    .titulo-etiqueta-maestro {
        font-family: 'Century Gothic', AppleGothic, sans-serif;
        color: #2c3e50;
        font-size: 1.8rem;
        border-bottom: 2px solid #dee2e6;
        padding-bottom: 10px;
        margin-bottom: 20px;
        text-align: right;
    }

    .contenedor-maestro-ficha {
        display: flex;
        gap: 15px;
        width: 100%;
        align-items: flex-start;
    }

    /* CONTENEDOR PRINCIPAL DERECHO EN PANTALLA */
    .bloque-derecho-total {
        display: flex;
        flex-direction: column;
        gap: 15px;
        flex: 3;
    }

    /* FILA SUPERIOR: Contiene las columnas 2, 3 y 4 en pantalla */
    .fila-columnas-superiores {
        display: flex;
        gap: 15px;
        width: 100%;
    }

    .columna-ficha {
        flex: 1;
        background: #ffffff;
        border: 1px solid #e1e4e8;
        border-radius: 8px;
        padding: 15px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    }

    /* Aplicación del parámetro manual a la Columna 1 */
    .contenedor-maestro-ficha > .columna-ficha {
        height: var(--altura-columna-principal);
        overflow-y: auto;
    }

    /* Aplicación del parámetro manual a las tres cajas de arriba a la derecha */
    .fila-columnas-superiores .columna-ficha {
        height: var(--altura-columnas-secundarias);
        overflow-y: auto;
    }

    .columna-ficha h3 {
        font-family: 'Century Gothic', sans-serif;
        font-size: 0.95rem;
        color: #2c3e50;
        border-bottom: 2px solid #2980b9;
        padding-bottom: 6px;
        margin-top: 0;
        margin-bottom: 15px;
        text-transform: none;
    }

    .grupo-dato {
        margin-bottom: 12px;
    }

        .grupo-dato label {
            font-size: 0.8rem;
            color: #7f8c8d;
            margin-bottom: 3px;
            display: block;
        }

    .valor-texto {
        font-size: 0.85rem;
        color: #2c3e50;
        background-color: #f8f9fa;
        border: 1px solid #ccd1d9;
        padding: 6px 12px;
        border-radius: 4px;
        min-height: 34px;
        display: flex;
        align-items: center;
        word-break: break-all;
    }

    .fila-fusionada {
        display: flex;
        gap: 10px;
    }

        .fila-fusionada > div {
            flex: 1;
        }

    /* Historial ubicado en el espacio inferior de las 3 columnas en pantalla */
    .contenedor-historial-etapas {
        background: #ffffff;
        border: 1px solid #e1e4e8;
        border-radius: 8px;
        padding: 15px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        width: 100%;
    }

        .contenedor-historial-etapas h3 {
            font-family: 'Century Gothic', sans-serif;
            font-size: 0.95rem;
            color: #2c3e50;
            border-bottom: 2px solid #2c3e50;
            padding-bottom: 6px;
            margin-top: 0;
            margin-bottom: 15px;
            text-transform: none;
        }

    .wrapper-tabla-scroll {
        max-height: 220px;
        overflow-y: auto;
        border: 1px solid #dee2e6;
        border-radius: 6px;
    }

    .table-historial {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-historial thead th {
            position: sticky;
            top: 0;
            background-color: #2c3e50 !important;
            color: #ffffff !important;
            z-index: 10;
            padding: 10px 12px;
            font-size: 0.85rem;
            font-weight: normal;
            border-bottom: 2px solid #1a252f;
            text-align: center;
        }

        .table-historial tbody td {
            padding: 8px 12px;
            font-size: 0.8rem;
            color: #2c3e50;
            border-bottom: 1px solid #dee2e6;
            text-align: center;
        }

        .table-historial tbody tr:nth-child(even) {
            background-color: #f8f9fa;
        }

    /* ========================================================================= */
    /* DISEÑO DEL PANEL DE BOTONES - ANCHO REPARTIDO AUTOMÁTICO                  */
    /* ========================================================================= */
    .panel-acciones-ficha {
        background-color: #2c3e50;
        border-radius: 6px;
        margin-top: 15px;
        margin-left: auto; /* Empuja todo el panel hacia la derecha */
        display: flex;
        width: 500px; /* Mantiene tus 500px */
        height: 40px;
        overflow: hidden;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .btn-ficha-grupo {
        display: flex;
        flex: 1; /* REPARTE EL ANCHO EQUITATIVAMENTE */
        justify-content: center; /* Centra el contenido */
        align-items: center;
        background: none;
        border: none;
        color: #ffffff;
        font-family: 'Century Gothic', sans-serif;
        font-size: 0.75rem;
        font-weight: normal !important;
        cursor: pointer;
        transition: background-color 0.2s ease;
        text-decoration: none;
        white-space: nowrap;
    }

        .btn-ficha-grupo i {
            margin-right: 6px; /* Un poco de margen para el icono */
            font-size: 0.85rem;
            font-weight: 900 !important;
        }

        .btn-ficha-grupo:hover {
            background-color: #34495e;
        }

        .btn-ficha-grupo + .btn-ficha-grupo {
            border-left: 1px solid rgba(255, 255, 255, 0.15);
        }

        .btn-ficha-grupo i {
            margin-right: 4px;
            font-size: 0.85rem;
            font-weight: 900 !important;
        }

        .btn-ficha-grupo:hover {
            background-color: #34495e;
        }

        .btn-ficha-grupo + .btn-ficha-grupo {
            border-left: 1px solid rgba(255, 255, 255, 0.15);
        }

    /* CONTENEDORES AUXILIARES EXCLUSIVOS PARA IMPRESIÓN (Oculto en pantalla) */
    .contenedor-historial-impresion-full, .bloque-firmas-impresion {
        display: none;
    }

    /* ========================================================================= */
    /* SECCIÓN DE AJUSTES EXCLUSIVOS PARA IMPRESIÓN PRO                          */
    /* ========================================================================= */
    @@media print {
        @@page {
            margin: 0;
        }

        body {
            font-size: 80% !important;
            background: #fff !important;
            color: #000 !important;
            padding: 5mm 5mm 5mm 5mm !important;
        }

        html {
            background: #fff !important;
        }

        .contenedor-maestro-ficha {
            display: flex !important;
            flex-direction: row !important;
            gap: 10px !important;
            width: 100% !important;
            align-items: flex-start !important;
        }

            .contenedor-maestro-ficha > .columna-ficha {
                height: auto !important;
                overflow: visible !important;
                flex: 1 !important;
            }

        .bloque-derecho-total {
            display: flex !important;
            flex-direction: row !important;
            gap: 10px !important;
            flex: 3 !important;
        }

        .fila-columnas-superiores {
            display: flex !important;
            flex-direction: row !important;
            gap: 10px !important;
            width: 100% !important;
        }

        .columna-ficha {
            padding: 8px !important;
            border-radius: 4px !important;
            box-shadow: none !important;
            height: auto !important;
            flex: 1 !important;
        }

        .bloque-derecho-total > .contenedor-historial-etapas {
            display: none !important;
        }

        .contenedor-historial-impresion-full {
            display: block !important;
            width: 100% !important;
            margin-top: 15px !important;
            margin-bottom: 20px !important;
        }

            .contenedor-historial-impresion-full .contenedor-historial-etapas {
                padding: 10px !important;
                box-shadow: none !important;
            }

        .table-historial {
            table-layout: auto !important;
            width: 100% !important;
        }

            .table-historial thead th {
                padding: 6px 8px !important;
                font-size: 0.75rem !important;
                white-space: nowrap !important;
            }

            .table-historial tbody td {
                padding: 3px 8px !important;
                font-size: 0.75rem !important;
            }

        .titulo-etiqueta-maestro {
            font-size: 1.4rem !important;
            margin-top: 10px !important;
            margin-bottom: 10px !important;
            padding-bottom: 5px !important;
            border-bottom: 1px solid #ccd1d9 !important;
            float: right;
            width: auto;
        }

        .header-impresion-bloque {
            display: block !important;
            float: left;
            margin-top: 0px;
            margin-bottom: 15px;
        }

        .logo-print-img-real {
            height: 52px;
            width: auto;
        }

        .bloque-firmas-impresion {
            display: flex !important;
            justify-content: space-between !important;
            margin-top: 40px !important;
            width: 100% !important;
            page-break-inside: avoid;
        }

        .espacio-firma-print {
            border-top: 1px dashed #7f8c8d !important;
            text-align: center !important;
            padding-top: 6px !important;
            width: 42% !important;
            font-family: 'Century Gothic', Arial, sans-serif !important;
            font-size: 0.8rem !important;
            color: #2c3e50 !important;
            font-weight: bold !important;
        }

        body::after {
            content: "Generado el: " attr(data-fecha-hora) "                                                                                                   Página 1 de 1";
            position: fixed;
            bottom: 5mm;
            left: 5mm;
            right: 5mm;
            font-size: 0.75rem;
            color: #7f8c8d;
            border-top: 1px solid #dee2e6;
            padding-top: 5px;
            font-family: 'Century Gothic', Arial, sans-serif;
            display: block;
        }

        aside, .sidebar, .main-sidebar, #sidebar-wrapper, .left-side, .menu-lateral, nav, .navbar, header, .main-header, .panel-acciones-ficha, .main-footer, footer {
            display: none !important;
        }

        body, .content-wrapper, .container, .container-fluid, .main-content, #wrapper, main {
            margin: 0 !important;
            padding: 5mm 5mm 5mm 5mm !important;
            width: 100% !important;
            max-width: 100% !important;
            left: 0 !important;
            display: block !important;
            position: relative !important;
        }

        .wrapper-tabla-scroll {
            height: auto !important;
            max-height: none !important;
            overflow: visible !important;
        }
    }

    /* Contenedor principal de la alerta */
    .swal-custom-popup {
        background-color: #ffffff !important;
        border: 2px solid #2c3e50 !important;
        border-radius: 8px !important;
        font-family: 'Century Gothic', sans-serif !important;
        padding-bottom: 15px !important;
    }

    .swal-custom-title {
        color: #2c3e50 !important;
        font-size: 0.60rem !important;
        font-weight: bold !important;
        border-bottom: 2px solid #2c3e50 !important;
        margin-bottom: 15px !important;
        padding-bottom: 10px !important;
    }

    .swal-custom-label {
        font-family: 'Century Gothic', sans-serif !important;
        color: #7f8c8d !important;
        font-size: 0.85rem !important;
        font-weight: normal !important;
        margin-top: 15px !important;
        margin-bottom: 5px !important;
        text-align: left !important;
        display: block !important;
        margin-left: 5% !important;
    }

    .swal-custom-input {
        background-color: #f8f9fa !important;
        border: 1px solid #ccd1d9 !important;
        padding: 8px 12px !important;
        border-radius: 4px !important;
        color: #2c3e50 !important;
        width: 90% !important;
        margin: 10px auto !important;
    }

    .swal-custom-actions {
        background-color: #2c3e50 !important;
        border-radius: 6px !important;
        padding: 5px !important;
        margin-top: 15px !important;
    }

    .swal-custom-btn {
        background: none !important;
        border: none !important;
        color: #ffffff !important;
        font-family: 'Century Gothic', sans-serif !important;
        font-size: 0.8rem !important;
        cursor: pointer !important;
        padding: 5px 20px !important;
    }

        .swal-custom-btn:hover {
            background-color: #34495e !important;
        }
</style>

<div class="header-impresion-bloque">
    <img src="~/img/BAXEN_Trazabilidad.png" class="logo-print-img-real" alt="Logo" />
</div>

<h1 class="titulo-etiqueta-maestro">
    Trazabilidad código reúso: <span id="lblTituloId">@idInicial</span>
</h1>

<div class="contenedor-maestro-ficha">

