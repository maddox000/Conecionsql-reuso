    }

    .menu-operaciones {
        background-color: #2c3e50;
        border-radius: 6px;
        padding: 5px;
        display: flex;
        flex-direction: column;
        width: 300px;
        border: 1px solid #1a252f;
    }

    .col-operaciones-container {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        margin-left: auto;
    }

    .btn-menu {
        background: transparent;
        border: none;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        color: #ecf0f1;
        padding: 18px 20px;
        text-align: left;
        font-size: 1.1em !important;
        display: flex;
        align-items: center;
        cursor: pointer;
        width: 100%;
    }

        .btn-menu .material-icons {
            margin-right: 15px;
            font-size: 22px;
        }

    /* .col-operaciones-container {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        margin-left: auto;
    }

    .menu-operaciones {
        background-color: #2c3e50;
        border-radius: 6px;
        padding: 5px;
        display: flex;
