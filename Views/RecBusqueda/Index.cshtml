    .panel-filtros {
        height: 270px !important;
        padding: 15px 25px !important;
        margin-bottom: 10px !important;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
    }

    .form-group input {
        width: 100%;
        box-sizing: border-box;
    }

    /* Anchos específicos
    #BUS_DEN, #BUS_PR, #BUS_REU_ID, #BUS_SEC_ORI, #BUS_SEC_DES {
        width: 300px !important;
        display: inline-block;
    }

    /* #BUS_PAC, #BUS_PRO, #BUS_ORT_DEN {
        width: 460px !important;
        display: inline-block;
    } */

    #BUS_REM, #BUS_FEN {
        width: 220px !important;
        display: inline-block;
    }

    /* ESTILO DEL CONTADOR */
    .badge-contador-grande {
        font-size: 1.2em;
        padding: 6px 14px;
        width: 270px !important;
        height: 45px;
