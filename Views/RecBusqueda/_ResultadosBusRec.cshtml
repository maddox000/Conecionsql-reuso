@model IEnumerable<ConexionSql.Models.SP_Busquedas.BusRecDto>

@if (Model != null && Model.Any())
{
    <div class="tabla-scroll-contenedor">
        <table class="table-baxen-resultados">
            <thead>
                <tr>
                    <th style="width: 8%;">Recepción</th>
                    <th style="width: 10%;">Fecha</th>
                    <th style="width: 8%;">Hora</th>
                    <th>Sector Origen</th>
                    <th>Sector Destino</th>
                    <th>Proveedor</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td ondblclick="window.location.href='/Busquedas/ConsultaRecepcion/@item.TB_REC_ID'"
                            style="font-weight: normal; color: #2c3e50; cursor:pointer; width: 8%;">
                            @item.TB_REC_ID
                        </td>
                        <td style="width: 10%;">
                            @(item.TB_REC_FEC.HasValue ? item.TB_REC_FEC.Value.ToString("dd/MM/yyyy") : "-")
                        </td>
                        <td style="width: 8%;">
                            @{
                                string horaCorta = "-";
                                if (item.TB_REC_HOR_INI != null)
                                {
                                    var hStr = item.TB_REC_HOR_INI.ToString();
                                    if (System.TimeSpan.TryParse(hStr, out System.TimeSpan ts))
                                    {
                                        // EL ARREGLO ESTÁ ACÁ: Sacamos el @ y usamos doble barra \\ para escapar
                                        horaCorta = ts.ToString("hh\\:mm");
                                    }
                                    else if (System.DateTime.TryParse(hStr, out System.DateTime dt))
                                    {
                                        horaCorta = dt.ToString("HH:mm");
                                    }
                                    else if (hStr.Length >= 5)
                                    {
                                        horaCorta = hStr.Substring(0, 5);
                                    }
                                }
                            }
                            @horaCorta
                        </td>
                        <td>@item.TB_REC_SEC_ORI_DEN</td>
                        <td>@item.TB_REC_SEC_DES_DEN</td>
                        <td>@item.TB_REC_ORT_DEN</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <script>
        var contador = document.getElementById('contador');
        if (contador) {
            contador.innerText = 'Registros: @Model.Count()';
        }
    </script>
}
else
{
    <div style="padding: 20px; text-align: center; color: #7f8c8d;">
        <span class="material-icons" style="font-size: 48px; display: block; margin-bottom: 10px;">inventory_2</span>
        No se encontraron registros de recepción en este rango.
    </div>

    <script>
        var contador = document.getElementById('contador');
        if (contador) {
            contador.innerText = 'Registros: 0';
        }
    </script>
}