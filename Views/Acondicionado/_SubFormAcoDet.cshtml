@model ConexionSql.Models.Acondicionado.TbProAcoDetFormDto

<link rel="stylesheet" href="~/css/views/crear-acondicionado.css" asp-append-version="true" />

<div class="subform-acondicionado mt-4">

    <!-- CABECERA (solo vista, copia exacta del estilo principal) -->
    <div class="aco-grid">
        <!-- Panel izquierdo -->
        <div class="aco-panel">
            <div class="aco-kv">
                <div class="aco-k">Número de proceso</div>
                <div class="aco-v" id="tbProAcoId">@Model.Cabecera.TbProAcoId</div>
            </div>
            <div class="aco-kv">
                <div class="aco-k">Usuario</div>
                <div class="aco-v">@Model.Cabecera.TbProAcoPerNom</div>
            </div>
            <div class="aco-kv">
                <div class="aco-k">Cargo</div>
                <div class="aco-v">ADMINISTRADOR</div>
            </div>
            <div class="aco-kv">
                <div class="aco-k">Total unidades</div>
                <div class="aco-v" id="cabeceraCantidad">@Model.Cabecera.TbProAcoUpro</div>
            </div>
        </div>

        <!-- Panel derecho -->
        <div class="aco-panel">
            <div class="aco-kv">
                <div class="aco-k">Fecha</div>
                <div class="aco-v">
                    @Model.Cabecera.TbProAcoHorIni?.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
        </div>
    </div>

    <div class="aco-tabbar mt-4">
        
        <button type="button" class="aco-tab is-active" data-tab-target="aco-tab-registrados">
            Materiales registrados
        </button>

        <button type="button" class="aco-tab" data-tab-target="aco-tab-pendientes">
            Materiales pendientes
        </button>
    </div>

    <div id="aco-tab-registrados" class="aco-tab-panel is-active">

    <!-- DETALLE (copia visual del estilo principal) -->
    <!-- Bloque de DETALLE (arriba) -->
    <div class="aco-table-wrap mt-4">
        <div class="aco-table-head-title">Registro de materiales</div>

        <div id="contenedor-aco-detalles">
            <table class="aco-table">
                <thead>
                    <tr>
                        <th>Código etiqueta</th>
                        <th>Denominación</th>
                        <th>Sector</th>
                        <th>Código reuso</th>
                        <th>Tipo de envoltorio</th>                     
                        <th>Recibidos</th>
                        <th>En proceso</th>
                        <th>Sin procesar</th>
                        <th>Cantidad</th>
                            <th>Eliminar</th>
                    </tr>
                </thead>
                <tbody>
                    <tbody id="tbody-aco-detalles">
                        @await Html.PartialAsync("~/Views/Acondicionado/_DetalleTablaAco.cshtml", Model.Detalles)
                    </tbody>
                </tbody>
            </table>
        </div>
    </div>
    </div>
    <!-- pestana materiales pendientes -->
    <div id="aco-tab-pendientes" class="aco-tab-panel">
        <div class="aco-table-wrap mt-4">
            <div class="aco-table-head-title">Materiales pendientes</div>

            <div id="contenedor-aco-pendientes">
                <table class="aco-table">
                    <thead>
                        <tr>
                            <th>Código etiqueta</th>
                            <th>Denominación</th>
                            <th>Sector</th>
                            <th>Código reuso</th>
                            <th>Recibidos</th>
                            <th>Registrados</th>
                            <th>Pendientes</th>
                            <th>Seleccionar</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-aco-pendientes">
                        <tr>
                            <td colspan="8">Sin materiales pendientes</td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    </div>


    <!-- Bloque de INGRESO DE DATOS (abajo) -->


    <div class="aco-operativo">
        <form id="formAcoDetalle" onsubmit="return false;">
            <input type="hidden" id="tbProAcoIdHidden" value="@Model.Cabecera.TbProAcoId" />
            <table class="aco-table">
                <thead>
                    <tr>
                        <th>Código etiqueta</th>
                        <th>Denominación</th>
                        <th>Sector</th>
                        <th>Código reuso</th>
                        <th>Tipo de envoltorio</th>
                        <th>Recibidos</th>
                        <th>En proceso</th>
                        <th>Sin procesar</th>
                        <th>Cantidad</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <!-- Input editable -->
                        <td>
                            <input type="text"
                                   id="tbRecDetId"
                                   name="tbRecDetId"
                                   class="form-control form-control-sm"
                                   placeholder="Ingrese código"
                                   required />
                        </td>
                        <!-- Campos que se completan automáticamente -->
                        <td><input type="text" id="materialNombre" class="form-control form-control-sm" readonly /></td>
                        <td><input type="text" id="sector" class="form-control form-control-sm" readonly /></td>
                        <td><input type="text" id="codigoReuso" class="form-control form-control-sm" readonly /></td>
                        <td><input type="text" id="tipoEnvoltorio" class="form-control form-control-sm" readonly /></td>
                        <td><input type="number" id="recibidos" class="form-control form-control-sm" readonly /></td>
                        <td><input type="number" id="enProceso" class="form-control form-control-sm" readonly /></td>
                        <td><input type="number" id="sinProcesar" class="form-control form-control-sm" readonly /></td>
                        <!-- Input editable -->
                        <td>
                            <input type="text"
                                   id="cantidad"
                                   name="cantidad"
                                   class="form-control form-control-sm"
                                   inputmode="numeric"
                                   pattern="[0-9]*"
                                   required />
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="aco-actions">
                <button type="button" id="btnRegistrarMasivoAco" class="btn btn-baxen btn-sm">
                    Registrar
                </button>
                <button type="button" class="btn btn-outline-primary btn-sm">Nuevo</button>
                <button type="button" class="btn btn-outline-primary btn-sm">Editar</button>
                <button type="button"
                        id="btnCerrarModulo"
                        class="btn btn-secondary btn-sm">
                    Cerrar
                </button>
            </div>
        </form>
        <div id="mensajeAco" class="mt-3"></div>
    </div>

    @await Html.PartialAsync("~/Views/Acondicionado/Modals/_ModalLavadoPendiente.cshtml")


    <script>
            document.addEventListener("DOMContentLoaded", function () {
                const inputEtiqueta = document.getElementById("tbRecDetId");
                const inputCantidad = document.getElementById("cantidad");
                const inputCabecera = document.getElementById("tbProAcoIdHidden");
                const inputMaterial = document.getElementById("materialNombre");
                const mensaje = document.getElementById("mensajeAco");
                const cabeceraCantidad = document.getElementById("cabeceraCantidad");
                const formAcoDetalle = document.getElementById("formAcoDetalle");

                const btnRegistrarMasivo = document.getElementById("btnRegistrarMasivoAco");

                if (btnRegistrarMasivo) {
                    btnRegistrarMasivo.addEventListener("click", function () {

                        console.log("CLICK REGISTRAR"); // para verificar

                        const tbProAcoId = parseInt(inputCabecera.value);

                        const etiquetas = Array.from(document.querySelectorAll(".chk-aco-pendiente:checked"))
                            .map(x => parseInt(x.value))
                            .filter(x => Number.isInteger(x));

                        if (etiquetas.length === 0) {
                            mensaje.innerText = "⚠️ Debe seleccionar al menos un material.";
                            mensaje.className = "text-danger mt-3";
                            return;
                        }

                        fetch("/TbProAcoDet/InsertarMasivo", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({
                                tbProAcoId: tbProAcoId,
                                etiquetas: etiquetas
                            })
                        })
                        .then(res => res.json())
                        .then(result => {
                            mensaje.innerText = result.success ? result.mensaje : "❌ " + result.mensaje;
                            mensaje.className = result.success ? "text-success mt-3" : "text-danger mt-3";

                            if (result.success) {
                                cargarDetallesAco(tbProAcoId);
                                cargarPendientesAco();
                            }
                        })
                        .catch(err => {
                            mensaje.innerText = "❌ Error: " + err.message;
                            mensaje.className = "text-danger mt-3";
                        });
                    });
                }

                cargarPendientesAco();

                if (!inputEtiqueta || !inputCantidad || !inputCabecera || !inputMaterial || !mensaje || !formAcoDetalle) {
                    return;
                }

                //abre modal de lavado

                function abrirModalLavadoPendiente(tbProLavId, mensajeModal) {

                    const modal =
                        document.getElementById("modalLavadoPendiente");

                    const txtMensaje =
                        document.getElementById("txtMensajeLavadoPendiente");

                    const btnAbrir =
                        document.getElementById("btnAbrirLavadoPendiente");

                    if (txtMensaje) {
                        txtMensaje.textContent =
                            mensajeModal || "";
                    }

                    if (btnAbrir) {

                        btnAbrir.onclick = function () {

                            window.open(
                                `/TbProLavBusqueda/ConsultaLavado?tbProLavId=${tbProLavId}`,
                                '_blank'
                            );

                            if (modal) {
                                modal.style.display = "none";
                            }
                        };
                    }

                    if (modal) {
                        modal.style.display = "flex";
                    }
                }

                //termina modal lavado

                inputEtiqueta.addEventListener("keydown", function (event) {
                    if (event.key === "Enter") {
                        event.preventDefault();

                        const idEtiqueta = parseInt(inputEtiqueta.value);

                        if (!Number.isInteger(idEtiqueta)) {
                            mensaje.innerText = "❌ Código inválido.";
                            mensaje.className = "text-danger mt-3";
                            inputEtiqueta.focus();
                            return;
                        }

                        fetch(`/TbProAcoDet/ValidarLavadoPendiente?id=${idEtiqueta}`)
                            .then(res => res.json())
                            .then(validacion => {

                                if (validacion.requiereFinalizarLavado === true) {

                                    abrirModalLavadoPendiente(
                                        validacion.tbProLavId,
                                        validacion.mensaje
                                    );

                                    return;
                                }

                                fetch(`/TbProAcoDet/ObtenerMaterial?tbRecDetId=${idEtiqueta}`)
                                    .then(res => res.json())
                                    .then(data => {
                                        if (data.success) {
                                            inputMaterial.value = data.nombre ?? "";
                                            document.getElementById("sector").value = data.sector ?? "";
                                            document.getElementById("codigoReuso").value = data.codigoReuso ?? "";
                                            document.getElementById("tipoEnvoltorio").value = data.tipoEnvoltorio ?? "";
                                            document.getElementById("recibidos").value = data.recibidos ?? 0;
                                            document.getElementById("enProceso").value = data.enProceso ?? 0;
                                            document.getElementById("sinProcesar").value = data.sinProcesar ?? 0;

                                            if (data.autoInsertar === true) {
                                                inputCantidad.value = data.cantidadAuto ?? 1;

                                                const tbProAcoId = parseInt(inputCabecera.value);

                                                fetch(`/TbProAcoDet/Insertar?tbRecDetId=${idEtiqueta}&cantidad=${inputCantidad.value}&tbProAcoId=${tbProAcoId}`, {
                                                    method: "POST"
                                                })
                                                .then(res => res.json())
                                                .then(result => {
                                                    mensaje.innerText = result.success ? result.mensaje : "❌ " + result.mensaje;
                                                    mensaje.className = result.success ? "text-success mt-3" : "text-danger mt-3";

                                                    if (result.success) {
                                                        formAcoDetalle.reset();
                                                        inputMaterial.value = "";

                                                        if (result.html) {
                                                            document.getElementById("tbody-aco-detalles").innerHTML = result.html;
                                                        }

                                                        if (cabeceraCantidad) {
                                                            const actual = parseInt(cabeceraCantidad.innerText || "0");
                                                            cabeceraCantidad.innerText = actual + 1;
                                                        }

                                                        inputEtiqueta.focus();
                                                    }
                                                })
                                                .catch(err => {
                                                    mensaje.innerText = "❌ Error al guardar: " + err.message;
                                                    mensaje.className = "text-danger mt-3";
                                                });
                                            } else {
                                                inputCantidad.focus();
                                            }

                                        } else {
                                            inputMaterial.value = "No encontrado";
                                            document.getElementById("sector").value = "";
                                            document.getElementById("codigoReuso").value = "";
                                            document.getElementById("tipoEnvoltorio").value = "";
                                            document.getElementById("recibidos").value = "";
                                            document.getElementById("enProceso").value = "";
                                            document.getElementById("sinProcesar").value = "";

                                            inputCantidad.focus();
                                        }
                                    })
                                    .catch(() => {
                                        inputMaterial.value = "Error";
                                        document.getElementById("sector").value = "";
                                        document.getElementById("codigoReuso").value = "";
                                        document.getElementById("tipoEnvoltorio").value = "";
                                        document.getElementById("recibidos").value = "";
                                        document.getElementById("enProceso").value = "";
                                        document.getElementById("sinProcesar").value = "";
                                        inputCantidad.focus();
                                    });
                            })
                            .catch(() => {
                                mensaje.innerText =
                                    "❌ Error al validar lavado pendiente.";

                                mensaje.className =
                                    "text-danger mt-3";
                            });
                    }
                });

                inputCantidad.addEventListener("keydown", function (event) {
                    if (event.key === "Enter") {
                        event.preventDefault();

                        const tbRecDetId = parseInt(inputEtiqueta.value);
                        const cantidad = parseInt(inputCantidad.value);
                        const tbProAcoId = parseInt(inputCabecera.value);

                        if (!Number.isInteger(tbRecDetId) || !Number.isInteger(cantidad) || cantidad < 1 || !Number.isInteger(tbProAcoId)) {
                            mensaje.innerText = "❌ Ingrese todos los datos correctamente.";
                            mensaje.className = "text-danger mt-3";
                            return;
                        }

                        fetch(`/TbProAcoDet/Insertar?tbRecDetId=${tbRecDetId}&cantidad=${cantidad}&tbProAcoId=${tbProAcoId}`, {
                            method: "POST"
                        })
                        .then(res => res.json())
                        .then(result => {
                            mensaje.innerText = result.success ? result.mensaje : "❌ " + result.mensaje;
                            mensaje.className = result.success ? "text-success mt-3" : "text-danger mt-3";

                            if (result.success) {
                                formAcoDetalle.reset();
                                inputMaterial.value = "";

                                if (result.html) {
                                     document.getElementById("tbody-aco-detalles").innerHTML = result.html;
                                }

                                if (cabeceraCantidad) {
                                    const actual = parseInt(cabeceraCantidad.innerText || "0");
                                    cabeceraCantidad.innerText = actual + cantidad;
                                }

                                inputEtiqueta.focus();
                            }
                        })
                        .catch(err => {
                            mensaje.innerText = "❌ Error al guardar: " + err.message;
                            mensaje.className = "text-danger mt-3";
                        });
                    }
                });
            });

            document.querySelectorAll(".aco-tab").forEach(btn => {
                btn.addEventListener("click", function () {
                    const targetId = this.dataset.tabTarget;

                    document.querySelectorAll(".aco-tab").forEach(x => x.classList.remove("is-active"));
                    document.querySelectorAll(".aco-tab-panel").forEach(x => x.classList.remove("is-active"));

                    this.classList.add("is-active");
                    document.getElementById(targetId)?.classList.add("is-active");
                });
            });

            // funcion cargar pendientes

            function cargarPendientesAco() {
                const tbody = document.getElementById("tbody-aco-pendientes");
                if (!tbody) return;

                fetch("/TbProAcoDet/ObtenerPendientes")
                    .then(res => res.json())
                    .then(json => {
                        console.log(json);

                        if (!json.success || !Array.isArray(json.data) || json.data.length === 0) {
                            tbody.innerHTML = `
                                <tr>
                                    <td colspan="8">Sin materiales pendientes</td>
                                </tr>`;
                            return;
                        }

                        tbody.innerHTML = "";

                        json.data.forEach(item => {
                            tbody.innerHTML += `
                                <tr>
                                    <td>${item.id}</td>
                                    <td>${item.material ?? ""}</td>
                                    <td>${item.sector ?? ""}</td>
                                    <td>${item.codigoReuso ?? ""}</td>
                                    <td>${item.recibidos ?? 0}</td>
                                    <td>${item.registrados ?? 0}</td>
                                    <td>${item.pendientes ?? 0}</td>
                                    <td style="text-align:center;">
                                        <input type="checkbox" class="chk-aco-pendiente" value="${item.id}" />
                                    </td>
                                </tr>`;
                        });

                        inicializarEventosCheckboxPendientes();
                    })
                    .catch(() => {
                        tbody.innerHTML = `
                            <tr>
                                <td colspan="8">Error al cargar datos</td>
                            </tr>`;
                    });
            }

            function inicializarEventosCheckboxPendientes() {
                const mensaje = document.getElementById("mensajeAco");

                document.querySelectorAll(".chk-aco-pendiente").forEach(chk => {
                    chk.addEventListener("change", () => {
                        if (mensaje) {
                            mensaje.innerText = "";
                            mensaje.className = "";
                        }
                    });
                });
            }

            function cargarDetallesAco(tbProAcoId) {
                fetch(`/TbProAcoDet/ObtenerDetallesAco?tbProAcoId=${tbProAcoId}`)
                    .then(res => res.json())
                    .then(result => {
                        if (result.success && result.html) {
                            document.getElementById("tbody-aco-detalles").innerHTML = result.html;
                        }
                    });
            }

            document.getElementById("btnCerrarModulo")
                ?.addEventListener("click", async function (e) {

                e.preventDefault();

                const tbProAcoId = parseInt(
                    document.getElementById("tbProAcoIdHidden").value
                );

                if (!tbProAcoId || tbProAcoId <= 0) {
                    window.location.href = "/";
                    return;
                }

                await fetch(`/TbProAcoDet/CerrarProceso?tbProAcoId=${tbProAcoId}`, {
                    method: "POST"
                });

                window.location.href = "/";
            });


            //para eliminar del detalle

            document.addEventListener('click', async function (event) {

                    const btnEliminar = event.target.closest('.js-aco-eliminar-detalle');

                    if (!btnEliminar) {
                        return;
                    }

                    const tbProAcoDetId = parseInt(btnEliminar.dataset.acoDetId);

                    if (!confirm('¿Eliminar el material del acondicionado?')) {
                        return;
                    }

                    const response = await fetch('/TbProAcoDet/EliminarDetalle', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(tbProAcoDetId)
                    });

                    const json = await response.json();

                    if (!json.success) {
                        alert(json.mensaje);
                        return;
                    }

                    const fila = document.getElementById(`fila-aco-det-${tbProAcoDetId}`);

                    if (fila) {
                        fila.style.opacity = "0.5";

                        const boton = fila.querySelector(".js-aco-eliminar-detalle");

                        if (boton) {
                            boton.disabled = true;
                            boton.style.pointerEvents = "none";
                        }
                    }
                });

    </script>


  