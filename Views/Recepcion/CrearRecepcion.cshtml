                    <tr style="height:150px;">
                        <td colspan="5"></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="rec-screen-table-wrap rec-wrap-detalle" style="margin-top:10px;">
                <div style="padding: 10px; background: white; border: 1px solid var(--color-borde); border-radius: 4px;">
            <div class="p-3">
                 <table style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr>
                                    <th style="width: 33.3%; font-size: 0.75rem; color: #666; padding-bottom: 5px; text-align: left;">Codigo Producto</th>
                                    <th style="font-size: 0.75rem; color: #666; padding-bottom: 5px; text-align: left;">Material</th>
                                    <th style="font-size: 0.75rem; color: #666; padding-bottom: 5px; text-align: left;">Codigo Reuso</th>
                                    <th style="font-size: 0.75rem; color: #666; padding-bottom: 5px; text-align: left;">Revision</th>
                                    <th style="font-size: 0.75rem; color: #666; padding-bottom: 5px; text-align: left;">Estado</th>
                                    <th style="font-size: 0.75rem; color: #666; padding-bottom: 5px; text-align: left;">Cantidad</th>
                                    <th style="width:110px; display:none;">Accion</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><input class="campo-detalle" style="width: 95%;" disabled /></td>
                                    <td><input class="campo-detalle" style="width: 95%;" disabled /></td>
                                    <td><input class="campo-detalle" style="width: 95%;" disabled /></td>
                                    <td><input class="campo-detalle" style="width: 95%;" disabled /></td>
                                    <td><input class="campo-detalle" style="width: 95%;" disabled /></td>
                                    <td><input class="campo-detalle" style="width: 100%;" disabled /></td>
                                    <td style="display:none;"></td>
                                </tr>
                            </tbody>
                </table>
            </div>
        </div>
       </div>
    }

    <form id="formEliminarDetalle" asp-action="EliminarDetalleMaterial" asp-controller="Recepcion" method="post" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" id="elimDetId" name="tbRecDetId" />
        <input type="hidden" name="tbRecId" value="@(Model != null && Model.TbRecId > 0 ? Model.TbRecId : 0)" />
    </form>
</div>

    
