@model List<ConexionSql.Models.Entrega.TbEntDetDto>

<div class="entrega-table-wrap" style="height:280px; overflow:auto;">
    <div class="entrega-table-head">Materiales entregados</div>

    <table class="entrega-table">
        <thead>
            <tr>
                <th>Código etiqueta</th>
                <th>Denominación</th>
                <th>Código reuso</th>
                <th>Recibidos</th>
                <th>Pendientes</th>
                <th>Entregados</th>
                <th>Cantidad</th>
                <th>Eliminar</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var item in Model)
                {
                    var estiloFila = item.TB_ENT_DET_DAT == "ELIMINADO"
                        ? "opacity:0.5;"
                        : "";

                    <tr id="fila-ent-det-@item.TB_ENT_DET_ID" style="@estiloFila">
                        <td ondblclick="window.location.href='/Traza/TrazaRecDetID/@item.TB_ENT_DET_REC_DET_ID'"
                            style="cursor:pointer;">
                            @item.TB_ENT_DET_REC_DET_ID
                        </td>
                        <td>@item.TbEntDetRecDetMatDen</td>
                        <td>@item.CodigoReuso</td>
                        <td>@item.Recibidos</td>
                        <td>@item.Pendientes</td>
                        <td>@item.Entregados</td>
                        <td>@item.TB_ENT_DET_CANT</td>
                        <td class="text-center">
                            <button type="button"
                                    class="btn btn-link text-danger p-0 js-ent-eliminar-detalle"
                                    data-ent-det-id="@item.TB_ENT_DET_ID"
                                    title="Eliminar"
                                @(item.TB_ENT_DET_DAT == "ELIMINADO" ? "disabled" : "")>
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">
                        No hay detalles cargados.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>