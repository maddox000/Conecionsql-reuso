@model List<ConexionSql.Models.Entrega.TbEntDetDto>

<div class="entrega-table-wrap" style="height:280px; overflow:auto;">
    <div class="entrega-table-head">Materiales entregados</div>

    <table class="entrega-table">
        <thead>
            <tr>
                <th>Código etiqueta</th>
                <th>Denominación</th>
                <th>Código reuso</th>
                <th>Recibidos</th>
                <th>Pendientes</th>
                <th>Entregados</th>
                <th>Cantidad</th>
                <th>Imprimir</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TB_ENT_DET_REC_DET_ID</td>
                        <td>@item.TbEntDetRecDetMatDen</td>
                        <td>@item.CodigoReuso</td>
                        <td>@item.Recibidos</td>
                        <td>@item.Pendientes</td>
                        <td>@item.Entregados</td>
                        <td>@item.TB_ENT_DET_CANT</td>
                        <td>
                            <button type="button"
                                    class="btn btn-danger btn-sm"
                                    onclick="eliminarDetalle(@item.TB_ENT_DET_ID)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">
                        No hay detalles cargados.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>