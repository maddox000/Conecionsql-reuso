    }

        .sugerencias-autocompletar li {
            padding: 8px 12px;
            cursor: pointer;
            font-size: 0.85rem;
            color: #2c3e50;
            transition: background 0.1s ease;
        }

            .sugerencias-autocompletar li:hover,
            .sugerencias-autocompletar li.elemento-seleccionado {
