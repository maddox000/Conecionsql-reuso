<div id="modalReproceso" class="modal-overlay">
    <div class="modal-box"
         style="width:480px; height:auto; min-height:240px;">

        <!-- HEADER -->
        <div class="modal-header">
            Reproceso requerido
        </div>

        <!-- BODY -->
        <div class="modal-body">

            <div style="display:flex; align-items:flex-start; gap:14px;">

                <div style="font-size:26px; line-height:1;">
                    ⚠️
                </div>

                <div style="flex:1;">

                    <div style="font-size:20px; font-weight:500; color:#1f2937; margin-bottom:10px;">
                        El proceso ha sido abortado.
                    </div>

                    <div style="font-size:15px; color:#374151; margin-bottom:10px;">
                        ¿Desea realizar el reproceso de los materiales?
                    </div>

                    <div id="txtMensajeReproceso"
                         style="
                        font-size:14px;
                        color:#374151;
                        max-height:80px;
                        overflow:auto;
                        white-space:pre-line;
                        ">
                    </div>

                </div>

            </div>

        </div>

        <!-- FOOTER -->
        <div class="modal-footer">
            <button type="button"
                    class="btn btn-secondary"
                    onclick="cerrarModalReproceso()">
                Cancelar
            </button>

            <button type="button"
                    class="btn btn-primary"
                    id="btnAceptarReproceso">
                Aceptar
            </button>
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const btnAceptar = document.getElementById("btnAceptarReproceso");

        if (!btnAceptar) return;

        btnAceptar.addEventListener("click", function () {
            try {
                const tbProId = document.getElementById("tbProId")?.value;

                ejecutarReproceso(tbProId);
            } catch (error) {
                console.error("ERROR EN CLICK REPROCESO:", error);
            }
        });

    });

        async function ejecutarReproceso(tbProId) {
        try {
            const response = await fetch('/TbProReproceso/EjecutarReproceso', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(parseInt(tbProId))
            });

            const json = await response.json();

            console.log("RESPUESTA REPROCESO:", json);

            if (json.success) {
                cerrarModalReproceso();
                alert(json.mensaje);

                // opcional simple: refrescar
                location.reload();
            } else {
                alert(json.mensaje);
            }

        } catch (error) {
            console.error("ERROR EJECUTAR REPROCESO:", error);
        }
    }

        function cerrarModalReproceso() {
        const modal = document.getElementById("modalReproceso");
        if (!modal) return;

        modal.style.display = "none";
    }
</script>
