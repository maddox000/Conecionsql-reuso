</div>

<div id="lavado-tab-cancelados" class="proceso-tab-panel">
    <div class="lavado-table-wrap lavado-table-wrap-auto">
        <div class="lavado-table-head-title">Materiales cancelados</div>

        <table class="lavado-table">
            <thead>
                <tr>
                    <th>Codigo etiqueta</th>
                    <th>Denominacion</th>
                    <th>Sector</th>
                    <th>Codigo reuso</th>
                    <th>Recibidos</th>
