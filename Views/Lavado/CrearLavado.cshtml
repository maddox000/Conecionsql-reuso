<div id="contenedorSubform" class="mt-5"></div>

@await Html.PartialAsync("~/Views/Shared/_BotonesInfoBasica.cshtml")

@section Scripts {
    <script>

            document.addEventListener("DOMContentLoaded", function () {
            const tabs = document.querySelectorAll('.proceso-tab[data-tab-target]');
            const panels = document.querySelectorAll('.proceso-tab-panel');

            tabs.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    const targetId = tab.getAttribute('data-tab-target');


                    tabs.forEach(function (t) {
                        t.classList.remove('is-active');
                    });

                    panels.forEach(function (p) {
                        p.classList.remove('is-active');
                    });

                    tab.classList.add('is-active');

                    const panel = document.getElementById(targetId);
                    if (panel) {
                        panel.classList.add('is-active');
                    }
                });
            });
        });



        async function guardarLavado() {
            const data = {
                TbProLavFec: document.getElementById("fechaLavado").value,
                TbProLavHorIni: document.getElementById("horaInicio").value,
                // TipoLavadoId: parseInt(document.getElementById("TipoLavadoId").value),
                // EquipoId: parseInt(document.getElementById("EquipoId").value),
                // TipoCicloId: parseInt(document.getElementById("TipoCicloId").value),
                // TipoLavadoDen: document.getElementById("TipoLavadoId").selectedOptions[0]?.text,
                // EquipoDen: document.getElementById("EquipoId").selectedOptions[0]?.text,
                // TipoCicloDen: document.getElementById("TipoCicloId").selectedOptions[0]?.text
                    TipoLavadoId: parseInt(document.getElementById("TipoLavadoId").value),
                    EquipoId: parseInt(document.getElementById("TipoLavadoId").value) === 4 ? 0 : parseInt(document.getElementById("EquipoId").value),
                    TipoCicloId: parseInt(document.getElementById("TipoLavadoId").value) === 4 ? 0 : parseInt(document.getElementById("TipoCicloId").value),
                    TipoLavadoDen: document.getElementById("TipoLavadoId").selectedOptions[0]?.text,
                    EquipoDen: parseInt(document.getElementById("TipoLavadoId").value) === 4 ? "NO REGISTRADO" : document.getElementById("EquipoId").selectedOptions[0]?.text,
                    TipoCicloDen: parseInt(document.getElementById("TipoLavadoId").value) === 4 ? "NO REGISTRADO" : document.getElementById("TipoCicloId").selectedOptions[0]?.text
            };

            if (!data.TipoLavadoId) {
                document.getElementById("mensajeLavado").innerText = "⚠️ Complete todos los campos.";
                return;
            }

            if (data.TipoLavadoId !== 4 && (!data.EquipoId || !data.TipoCicloId)) {
            document.getElementById("mensajeLavado").innerText = "⚠️ Complete todos los campos.";
            return;
             }

            const resp = await fetch('/Lavado/Insertar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const json = await resp.json();

            if (json.success) {
                window.location.href = `/TbProLavDet/SubFormulario?id=${json.tbProLavId}`;
            } else {
                document.getElementById("mensajeLavado").innerText = json.mensaje || "❌ Error al guardar.";
            }
        }

                document.getElementById("TipoLavadoId").addEventListener("change", async function () {

            const tipoLavadoId = parseInt(this.value) || 0;
            const esManual = tipoLavadoId === 4;

            const comboEquipo = document.getElementById("EquipoId");
            const comboCiclo = document.getElementById("TipoCicloId");

            const bloqueEquipo = document.getElementById("bloqueEquipo");
            const bloqueTipoCiclo = document.getElementById("bloqueTipoCiclo");

            // 🔴 CASO MANUAL
            if (esManual) {
                bloqueEquipo.style.display = "none";
                bloqueTipoCiclo.style.display = "none";

                comboEquipo.innerHTML = '<option value="0" selected>NO REGISTRADO</option>';
                comboCiclo.innerHTML = '<option value="0" selected>NO REGISTRADO</option>';

                return; // 🔥 corta acá → no ejecuta fetch
            }

            // 🟢 CASO NORMAL
            bloqueEquipo.style.display = "";
            bloqueTipoCiclo.style.display = "";

            comboEquipo.innerHTML = '<option value="">-- Cargando equipos... --</option>';
            comboCiclo.innerHTML = '<option value="">-- Cargando ciclos... --</option>';

            const resp = await fetch(`/Lavado/ObtenerEquiposPorTipo`);
            const data = await resp.json();

            comboEquipo.innerHTML = '<option value="">-- Seleccionar equipo --</option>';
            data.forEach(e => {
                const opt = document.createElement("option");
                opt.value = e.id;
                opt.text = e.nombre;
                comboEquipo.appendChild(opt);
            });

            

            const respCiclos = await fetch(`/Lavado/ObtenerTiposCiclo`);
            const dataCiclos = await respCiclos.json();

            comboCiclo.innerHTML = '<option value="">-- Seleccionar ciclo --</option>';
            dataCiclos.forEach(c => {
                const opt = document.createElement("option");
                opt.value = c.id;
                opt.text = c.nombre;
                comboCiclo.appendChild(opt);
            });
        });
    </script>
    <script>
        localStorage.setItem("modulo_134_abierto", "1");

        window.addEventListener("beforeunload", function () {
            localStorage.removeItem("modulo_134_abierto");
        });
    </script>
}