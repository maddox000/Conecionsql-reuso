<div id="modalReprocesoParcialLavado" class="modal-overlay">
    <div class="modal-box"
         style="width:480px; height:auto; min-height:240px;">

        <!-- HEADER -->
        <div class="modal-header">
            Reproceso parcial
        </div>

        <!-- BODY -->
        <div class="modal-body">

            <div style="display:flex; align-items:flex-start; gap:14px;">

                <div style="font-size:26px; line-height:1;">
                    ⚠️
                </div>

                <div style="flex:1;">

                    <div style="font-size:20px; font-weight:500; color:#1f2937; margin-bottom:10px;">
                        Se realizará un reproceso parcial.
                    </div>

                    <div style="font-size:15px; color:#374151; margin-bottom:10px;">
                        Seleccione el motivo del reproceso parcial.
                    </div>

                    <div id="txtMensajeReprocesoParcialLavado"
                         style="
                        font-size:14px;
                        color:#374151;
                        max-height:120px;
                        overflow:auto;
                        white-space:normal;
                        ">
                    </div>

                </div>

            </div>

        </div>

        <!-- FOOTER -->
        <div class="modal-footer">
            <button type="button"
                    class="btn btn-secondary"
                    onclick="cerrarModalReprocesoParcialLavado()">
                Cancelar
            </button>

            <button type="button"
                    class="btn btn-primary"
                    id="btnAceptarReprocesoParcialLavado">
                Aceptar
            </button>
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const btnAceptar =
            document.getElementById("btnAceptarReprocesoParcialLavado");

        if (!btnAceptar)
            return;

        btnAceptar.addEventListener("click", function () {

            try {

                const motivoSeleccionado =
                    document.querySelector(
                        "input[name='motivoReprocesoParcialLavado']:checked"
                    );

                if (!motivoSeleccionado) {

                    alert("Debe seleccionar un motivo de reproceso.");
                    return;
                }

                sessionStorage.setItem(
                    "motivoReprocesoParcialLavadoId",
                    motivoSeleccionado.value
                );

                cerrarModalReprocesoParcialLavado();

                document
                    .querySelector('[data-tab-target="lavado-tab-materiales"]')
                    ?.click();

                document
                    .querySelectorAll(".chkReprocesoParcial")
                    .forEach(x => {
                        x.disabled = false;
                    });

                document
                    .querySelectorAll(".cantReprocesoParcial")
                    .forEach(x => {
                        x.disabled = false;
                    });

                document
                    .querySelectorAll(".col-reproceso")
                    .forEach(x => {
                        x.classList.remove("d-none");
                    });

                const btnReprocesar =
                    document.getElementById("btnReprocesarMateriales");

                if (btnReprocesar) {
                    btnReprocesar.disabled = false;
                }

            }
            catch (error) {

                console.error(
                    "ERROR EN CLICK REPROCESO PARCIAL LAVADO:",
                    error
                );
            }
        });
    });

    async function ejecutarReprocesoParcialLavado(
        tbProLavId,
        motivoId
    ) {

        try {

            const response =
                await fetch(
                    '/TbProLavReproceso/EjecutarReprocesoParcial',
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },

                        body: JSON.stringify({
                            tbProLavId:
                                parseInt(tbProLavId),

                            motivoId:
                                parseInt(motivoId)
                        })
                    });

            const json =
                await response.json();

            console.log(
                "RESPUESTA REPROCESO PARCIAL LAVADO:",
                json
            );

            if (json.success) {

                cerrarModalReprocesoParcialLavado();

                alert(json.mensaje);

                location.reload();

            } else {

                alert(json.mensaje);
            }

        }
        catch (error) {

            console.error(
                "ERROR EJECUTAR REPROCESO PARCIAL LAVADO:",
                error
            );
        }
    }

    function cerrarModalReprocesoParcialLavado() {

        const modal =
            document.getElementById(
                "modalReprocesoParcialLavado"
            );

        if (!modal)
            return;

        modal.style.display = "none";
    }

    document
    .getElementById("btnReprocesarMateriales")
    ?.addEventListener(
    "click",
    async function () {

        const tbProLavId =
            parseInt(
                document.getElementById("tbProLavId")?.value
            ) || 0;

        const motivoId =
            parseInt(
                sessionStorage.getItem(
                    "motivoReprocesoParcialLavadoId"
                )
            ) || 0;

        const detallesSeleccionados =
            Array.from(
                document.querySelectorAll(
                    ".chkReprocesoParcial:checked"
                )
            )
            .map(chk => {

                const tbProLavDetId =
                    parseInt(chk.value);

                const inputCantidad =
                    document.querySelector(
                        `.cantReprocesoParcial[data-det-id='${tbProLavDetId}']`
                    );

                const cantidad =
                    parseInt(inputCantidad?.value) || 0;

                return {

                    TbProLavDetId:
                        tbProLavDetId,

                    Cantidad:
                        cantidad
                };
            });

        if (tbProLavId <= 0) {

            alert("Lavado inválido.");
            return;
        }

        if (motivoId <= 0) {

            alert(
                "Debe seleccionar un motivo de reproceso."
            );

            return;
        }

        if (detallesSeleccionados.length === 0) {

            alert(
                "Debe seleccionar al menos un material."
            );

            return;
        }

        try {

            const response =
                await fetch(
                    '/TbProLavReproceso/EjecutarReprocesoParcial',
                    {
                        method: 'POST',

                        headers: {
                            'Content-Type':
                                'application/json'
                        },

                        body: JSON.stringify({

                            tbProLavId:
                                tbProLavId,

                            motivoId:
                                motivoId,

                            detalles:
                                detallesSeleccionados
                        })
                    });

            const json =
                await response.json();

            if (json.success) {

                alert(json.mensaje);

                location.reload();

            } else {

                alert(json.mensaje);
            }

        }
        catch (error) {

            console.error(
                "ERROR REPROCESO PARCIAL LAVADO:",
                error
            );

            alert(
                "Error al ejecutar reproceso parcial."
            );
        }
    });

    async function cargarMotivosReprocesoParcialLavado() {

        try {

            const response =
                await fetch(
                    '/TbProLavReproceso/ObtenerNoConformidades'
                );

            const json =
                await response.json();

            if (!json.success)
                return;

            const contenedor =
                document.getElementById(
                    "txtMensajeReprocesoParcialLavado"
                );

            if (!contenedor)
                return;

            contenedor.innerHTML =
                json.data.map(x => `
                    <div style="margin-bottom:8px;">
                        <label>
                            <input type="radio"
                                   name="motivoReprocesoParcialLavado"
                                   value="${x.id}">
                            ${x.den}
                        </label>
                    </div>
                `).join("");

        }
        catch(ex)
        {
            console.error(
                "ERROR CARGANDO MOTIVOS:",
                ex
            );
        }
    }

    document.addEventListener(
    "DOMContentLoaded",
    function () {
        cargarMotivosReprocesoParcialLavado();
    });

</script>