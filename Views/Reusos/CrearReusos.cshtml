                                    <div id="listaMaterialesReuso" class="list-group mt-2"></div>

                                    <input type="hidden" id="TbReuMatId" name="TbReuMatId" />
                                </div>
                            </div>
                        </div>

                        <div class="reu-screen-kv">
                            <div class="reu-screen-k">Marca</div>
                            <div class="reu-screen-v">
                                <input type="text" class="form-control form-control-sm"
                                       id="TbReuMatMca" name="TbReuMatMca"
                                       value="@Model?.TbReuMatMca" />
                            </div>
                        </div>

                        <div class="reu-screen-kv">
                            <div class="reu-screen-k">Identificación</div>
                            <div class="reu-screen-v">
                                <input type="text" class="form-control form-control-sm"
                                       id="TbReuMatIde" name="TbReuMatIde"
                                       value="@Model?.TbReuMatIde" />
                            </div>
                        </div>

                        <div class="reu-screen-kv">
                            <div class="reu-screen-k">Fabricante</div>
                            <div class="reu-screen-v">
                                <input type="text" class="form-control form-control-sm"
