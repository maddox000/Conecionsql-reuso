@model ConexionSql.Models.Reuso.TbReuDto

@{
    ViewData["Title"] = "Reusos";

    var codigoReuso = Model?.TbReuIdForm ?? "Pendiente";
    var usuario = $"{Model?.TbReuPerApe} {Model?.TbReuPerNom}".Trim();
    if (string.IsNullOrWhiteSpace(usuario)) usuario = ViewBag.UsuarioLogueado ?? "NO REGISTRADO";

    var cargo = Model?.TbReuPerCarDen ?? "";
    var fecha = Model?.TbReuFec?.ToString("dd/MM/yyyy") ?? DateTime.Now.ToString("dd/MM/yyyy");
    var hora = Model?.TbReuHorIni?.ToString("HH:mm") ?? DateTime.Now.ToString("HH:mm");
    var listaSectores = ViewBag.ListaSectores as List<ConexionSql.Models.Sectores.IbSec>;
}

<link rel="stylesheet" href="~/css/views/crear-reusos.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/views/info-basica.css" asp-append-version="true" />

