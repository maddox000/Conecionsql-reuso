                            <div class="reu-screen-kv">
                                <div class="reu-screen-k">Reusos registrados</div>
                                <div class="reu-screen-v">
                                    <input type="text" class="form-control form-control-sm"
                                           id="TbReuMatOpcReg" name="TbReuMatOpcReg"
                                           value="@Model?.TbReuMatOpcReg" />
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </td>

            <td class="reu-right-col">

                <div class="reu-screen-panel">
                    <div class="reu-screen-kv">
                        <div class="reu-screen-k">Fecha</div>
                        <div class="reu-screen-v">@fecha &nbsp;&nbsp; @hora</div>
