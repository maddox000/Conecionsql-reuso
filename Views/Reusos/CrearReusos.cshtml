                    <td colspan="8" class="reu-screen-note">Sin registros</td>
                </tr>
            </tbody>
        </table>
    </div>

</div>

@await Html.PartialAsync("~/Views/Shared/_BotonesInfoBasica.cshtml")




<script>
    document.addEventListener("DOMContentLoaded", function () {

        // =========================
        // SECTORES
        // =========================

        const sectores = [
            @if (listaSectores != null)
            {
                    for (int i = 0; i < listaSectores.Count; i++)
                    {
                            var s = listaSectores[i];
                            @:{ id: @s.IbSecId, den: "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(s.IbSecDen ?? ""))" }@(i < listaSectores.Count - 1 ? "," : "")
                    }
            }
        ];

        const inputSec = document.getElementById("TbReuSecBusqueda");
        const hiddenSec = document.getElementById("TbReuSecId");
        const listaSec = document.getElementById("listaSectoresReuso");

        let filtradosSec = [];
        let indiceSec = -1;

        function renderSec(items) {
            filtradosSec = items || [];
            listaSec.innerHTML = "";

            if (!items.length) {
                listaSec.style.display = "none";
                return;
            }

            items.forEach((sec, i) => {
                const item = document.createElement("button");
                item.type = "button";
                item.className = "list-group-item list-group-item-action";
                item.textContent = sec.den;

                if (i === indiceSec) item.classList.add("active");

                item.onclick = () => {
                    inputSec.value = sec.den;
                    hiddenSec.value = sec.id;
                    listaSec.style.display = "none";

                    const inputDen = document.getElementById("TbReuMatDen");
                    if (inputDen) {
                        inputDen.focus();
                        inputDen.select();
                    }
                };

                listaSec.appendChild(item);
            });

            listaSec.style.display = "block";
        }

        inputSec.addEventListener("focus", () => { indiceSec = -1; renderSec(sectores); });
        inputSec.addEventListener("click", () => { indiceSec = -1; renderSec(sectores); });

        inputSec.addEventListener("input", function () {
            indiceSec = -1;
            hiddenSec.value = "";

            const f = sectores.filter(x =>
                x.den.toLowerCase().includes(this.value.toLowerCase())
            );

            renderSec(f);
        });

        inputSec.addEventListener("keydown", function (e) {

            if (e.key === "ArrowDown") {
                if (!filtradosSec.length) return;
                e.preventDefault();
                indiceSec = (indiceSec + 1) % filtradosSec.length;
                renderSec(filtradosSec);
            }

            if (e.key === "ArrowUp") {
                if (!filtradosSec.length) return;
                e.preventDefault();
                indiceSec = (indiceSec - 1 + filtradosSec.length) % filtradosSec.length;
                renderSec(filtradosSec);
            }

            if (e.key === "Enter") {
                e.preventDefault();

                let seleccionado = null;

                if (indiceSec >= 0 && filtradosSec.length > 0) {
                    seleccionado = filtradosSec[indiceSec];
                } else {
                    seleccionado = sectores.find(x => x.den === inputSec.value.trim());
                }

                if (seleccionado) {
                    inputSec.value = seleccionado.den;
                    hiddenSec.value = seleccionado.id;
                    listaSec.style.display = "none";

                    const inputDen = document.getElementById("TbReuMatDen");
                    if (inputDen) {
                        inputDen.focus();
                        inputDen.select();
                    }
                }
            }
        });

        // =========================
        // MATERIALES
        // =========================

        const materiales = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ListaMateriales ?? new List<object>()));

        const inputMat = document.getElementById("TbReuMatBusqueda");
        const hiddenMat = document.getElementById("TbReuMatId");
        const listaMat = document.getElementById("listaMaterialesReuso");

        const inputDen = document.getElementById("TbReuMatDen");
        const listaMatDen = document.getElementById("listaMaterialesReusoDen");

        const inputReusosPermitidos = document.getElementById("TbReuMatOpcCant");

        let filtradosMat = [];
        let indiceMat = -1;

        function seleccionarMat(mat) {
            inputMat.value = mat.pr ?? "";
            hiddenMat.value = mat.id ?? "";

            if (inputDen) inputDen.value = mat.den ?? "";
            if (inputReusosPermitidos) inputReusosPermitidos.value = mat.reuOpcCant ?? "";
            const inputVto = document.getElementById("TbReuVto");
                if (inputVto && mat.vtoDefault) {
                    inputVto.value = mat.vtoDefault;
                }

            listaMat.style.display = "none";
            listaMat.innerHTML = "";

            if (listaMatDen) {
                listaMatDen.style.display = "none";
                listaMatDen.innerHTML = "";
            }

            const inputMarca = document.getElementById("TbReuMatMca");
            if (inputMarca) {
                inputMarca.focus();
                inputMarca.select();
            }
        }

        function renderMat(items, listaDestino, tipo) {
            filtradosMat = items || [];
            listaDestino.innerHTML = "";

            if (!items.length) {
                listaDestino.style.display = "none";
                return;
            }

            items.forEach((mat, i) => {
                const item = document.createElement("button");
                item.type = "button";
                item.className = "list-group-item list-group-item-action";
                item.textContent = tipo === "den" ? (mat.den ?? "") : (mat.pr ?? "");

                if (i === indiceMat) item.classList.add("active");

                item.onclick = () => seleccionarMat(mat);

                listaDestino.appendChild(item);
            });

            listaDestino.style.display = "block";
        }

        function buscarPorDen(texto) {
            const t = texto.toLowerCase();

            return materiales.filter(x =>
                (x.den ?? "").toLowerCase().includes(t)
            );
        }

        function buscarPorPr(texto) {
            const t = texto.toString();

            return materiales.filter(x =>
                (x.pr ?? "").toString().includes(t)
            );
        }

        inputDen.addEventListener("click", () => {
            indiceMat = -1;
            if (listaMat) listaMat.style.display = "none";
            renderMat(materiales, listaMatDen, "den");
        });

        inputDen.addEventListener("input", function () {
            indiceMat = -1;
            hiddenMat.value = "";

            const f = buscarPorDen(this.value);
            renderMat(f, listaMatDen, "den");
        });

        inputDen.addEventListener("keydown", function (e) {
            if (e.key === "ArrowDown") {
                if (!filtradosMat.length) return;

                e.preventDefault();
                indiceMat = (indiceMat + 1) % filtradosMat.length;
                renderMat(filtradosMat, listaMatDen, "den");
            }

            if (e.key === "ArrowUp") {
                if (!filtradosMat.length) return;

                e.preventDefault();
                indiceMat = (indiceMat - 1 + filtradosMat.length) % filtradosMat.length;
                renderMat(filtradosMat, listaMatDen, "den");
            }

            if (e.key === "Enter") {
                e.preventDefault();

                let seleccionado = null;

                if (indiceMat >= 0 && filtradosMat.length > 0) {
                    seleccionado = filtradosMat[indiceMat];
                } else {
                    seleccionado = materiales.find(x =>
                        (x.den ?? "") === inputDen.value.trim()
                    );
                }

                if (seleccionado) {
                    seleccionarMat(seleccionado);
                    return;
                }

                if (inputMat) {
                    inputMat.focus();
                    inputMat.select();
                }
            }
        });

        inputMat.addEventListener("click", () => {
            indiceMat = -1;
            if (listaMatDen) listaMatDen.style.display = "none";
            renderMat(materiales, listaMat, "pr");
        });

        inputMat.addEventListener("input", function () {
            indiceMat = -1;
            hiddenMat.value = "";

            const f = buscarPorPr(this.value);
            renderMat(f, listaMat, "pr");
        });

        inputMat.addEventListener("keydown", function (e) {
            if (e.key === "ArrowDown") {
                if (!filtradosMat.length) return;

                e.preventDefault();
                indiceMat = (indiceMat + 1) % filtradosMat.length;
                renderMat(filtradosMat, listaMat, "pr");
            }

            if (e.key === "ArrowUp") {
                if (!filtradosMat.length) return;

                e.preventDefault();
                indiceMat = (indiceMat - 1 + filtradosMat.length) % filtradosMat.length;
                renderMat(filtradosMat, listaMat, "pr");
            }

            if (e.key === "Enter") {
                e.preventDefault();

                let seleccionado = null;

                if (indiceMat >= 0 && filtradosMat.length > 0) {
                    seleccionado = filtradosMat[indiceMat];
                } else {
                    seleccionado = materiales.find(x =>
                        (x.pr ?? "").toString() === inputMat.value.trim()
                    );
                }

                if (seleccionado) {
                    seleccionarMat(seleccionado);
                    return;
                }

                const inputMarca = document.getElementById("TbReuMatMca");
                if (inputMarca) {
                    inputMarca.focus();
                    inputMarca.select();
                }
            }
        });

        // =========================
        // mayusc los datos
        // =========================

        [
            "TbReuMatMca",
            "TbReuMatIde",
            "TbReuMatFab",
            "TbReuLot",
            "TbReuMem1"
                ].forEach(id => {

                    const campo = document.getElementById(id);

                    if (!campo) return;

                    campo.addEventListener("input", function () {
                        this.value = this.value.toUpperCase();
                    });
                });

        // =========================
        // ENTER ENTRE CAMPOS
        // =========================

        const ordenCamposReuso = [
            "TbReuMatMca",
            "TbReuMatIde",
            "TbReuMatFab",
            "TbReuLot",
            "TbReuVto",
            "TbReuMatOpcReg",
            "TbReuMem1"
        ];

        ordenCamposReuso.forEach((id, index) => {
            const campo = document.getElementById(id);

            if (!campo) return;

                    campo.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();

                // 🔴 SI ES REUSOS REGISTRADOS → GUARDAR
                if (id === "TbReuMatOpcReg") {

                    const data = {
                        TbReuIdForm: "@codigoReuso",

                        TbReuPerId: @Model?.TbReuPerId ?? 0,
                        TbReuPerNom: "@(Model?.TbReuPerNom ?? "")",
                        TbReuPerApe: "@(Model?.TbReuPerApe ?? "")",
                        TbReuPerCarId: @Model?.TbReuPerCarId ?? 0,
                        TbReuPerCarDen: "@(Model?.TbReuPerCarDen ?? "")",

                        TbReuSecId: document.getElementById("TbReuSecId")?.value,
                        TbReuMatId: document.getElementById("TbReuMatId")?.value,

                        TbReuMatMca: document.getElementById("TbReuMatMca")?.value,
                        TbReuMatFab: document.getElementById("TbReuMatFab")?.value,
                        TbReuMatIde: document.getElementById("TbReuMatIde")?.value,

                        TbReuMatOpcCant: document.getElementById("TbReuMatOpcCant")?.value,
                        TbReuMatOpcReg: document.getElementById("TbReuMatOpcReg")?.value,

                        TbReuTxt1: document.getElementById("TbReuLot")?.value,
                        TbReuDti1: document.getElementById("TbReuVto")?.value,

                        TbReuMem1: document.getElementById("TbReuMem1")?.value
                    };

                        console.log("DATA REUSO:", data);
                             //alert("Codigo que mando: " + data.TbReuIdForm);

                    fetch("/Reusos/ActualizarReuso", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify(data)
                    })
                    .then(r => r.json())
                    .then(res => {
                        if (res.success) {
                            console.log("✔ UPDATE OK");

                        const msg = document.getElementById("msgReuso");

                                if (msg) {
                                    msg.innerText = "✔ Código de reúso registrado correctamente";
                                    msg.style.display = "block";
                                }

                            const siguiente = document.getElementById("TbReuMem1");
                            if (siguiente) {
                                siguiente.focus();
                                siguiente.select();
                            }
                        } else {
                            alert(res.mensaje || "Error al actualizar");
                        }
                    })
                    .catch(() => alert("Error de conexión"));

                    return;
                }

                // 🟢 flujo normal
                const siguienteId = ordenCamposReuso[index + 1];

                if (siguienteId) {
                    const siguiente = document.getElementById(siguienteId);

                    if (siguiente) {
                        siguiente.focus();
                        if (siguiente.select) siguiente.select();
                    }
                }
            }
        });

        // =========================
        // FOCO INICIAL
        // =========================

        if (inputSec) {
            setTimeout(() => {
                inputSec.focus();
                inputSec.select();
                listaSec.style.display = "none";
            }, 200);
        }
        });
    });
</script>