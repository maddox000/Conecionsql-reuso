@{
    ViewData["Title"] = "Prueba Modal Personal";
}

<link rel="stylesheet" href="~/css/infobasica-custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/views/crear-recepcion.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/views/area-sistema.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/views/info-basica.css" asp-append-version="true" />

<div id="modalPersonalABM" class="infobasica-modal" style="display:block;">
    <div class="infobasica-modal-contenido">
        <div class="infobasica-modal-header" id="modalPersonalTitulo">
            Nuevo Personal
        </div>

        <form asp-action="Guardar" method="post">
            @Html.AntiForgeryToken()

            <div class="infobasica-modal-body">
                <input type="hidden" name="Id" id="input_PersonalId" value="0" />

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px 18px;">
                    <div>
                        <label class="label-detalle">Apellido</label>
                        <input type="text" name="Apellido" id="input_Apellido" class="infobasica-campo" required maxlength="50" />
                    </div>

                    <div>
                        <label class="label-detalle">Nombre</label>
                        <input type="text" name="Nombre" id="input_Nombre" class="infobasica-campo" required maxlength="50" />
                    </div>

                    <div>
                        <label class="label-detalle">Cargo</label>

                        <div style="position:relative;">
                            <input type="text"
                                   id="cargoBusqueda"
                                   class="infobasica-campo"
                                   autocomplete="off" />

                            <div id="listaCargos"
                                 class="list-group"
                                 style="position:absolute;
                                top:100%;
                                left:0;
                                right:0;
                                z-index:9999;
                                max-height:220px;
                                overflow-y:auto;
                                display:none;">
                            </div>

                            <input type="hidden"
                                   id="CargoId"
                                   name="CargoId" />
                        </div>
                    </div>

                    <div>
                        <label class="label-detalle">Nivel usuario</label>

                        <div style="position:relative;">
                            <input type="text"
                                   id="nivelUsuarioBusqueda"
                                   class="infobasica-campo"
                                   autocomplete="off" />

                            <div id="listaNivelesUsuario"
                                 class="list-group"
                                 style="position:absolute;
                                top:100%;
                                left:0;
                                right:0;
                                z-index:9999;
                                max-height:220px;
                                overflow-y:auto;
                                display:none;">
                            </div>

                            <input type="hidden"
                                   id="NivelUsuarioId"
                                   name="NivelUsuarioId" />
                        </div>
                    </div>

                    <div>
                        <label class="label-detalle">Sector</label>

                        <div style="position:relative;">
                            <input type="text"
                                   id="sectorBusqueda"
                                   class="infobasica-campo"
                                   autocomplete="off" />

                            <div id="listaSectores"
                                 class="list-group"
                                 style="position:absolute;
                                top:100%;
                                left:0;
                                right:0;
                                z-index:9999;
                                max-height:220px;
                                overflow-y:auto;
                                display:none;">
                            </div>

                            <input type="hidden"
                                   id="SectorId"
                                   name="SectorId" />
                        </div>
                    </div>

                    <div>
                        <label class="label-detalle">Inhabilitado</label>
                        <div style="height: 34px; display: flex; align-items: center;">
                            <label style="display: flex; align-items: center; gap: 10px; font-size: 0.85rem; color: #444;">
                                <input type="checkbox" name="Inhabilitado" id="input_Inhabilitado" value="true" />
                                Ocultar en sistema
                            </label>
                        </div>
                    </div>

                    <div>
                        <label class="label-detalle">Contraseña</label>
                        <input type="password" name="Password" id="input_Password" class="infobasica-campo" maxlength="50" />
                    </div>

                    <div>
                        <label class="label-detalle">Repetir contraseña</label>
                        <input type="password" name="PasswordRepite" id="input_PasswordRepite" class="infobasica-campo" maxlength="50" />
                    </div>
                </div>
            </div>

            <div class="infobasica-modal-footer">
                <button type="button"
                        style="background-color: #6c757d; color: white; border: none; padding: 8px 15px; border-radius: 4px; cursor: pointer; font-size: 0.85rem; margin-right: 0px;">
                    Cancelar
                </button>

                <button type="submit"
                        style="background-color: #34495e; color: white; border: none; padding: 8px 15px; border-radius: 4px; cursor: pointer; font-size: 0.85rem; font-weight: 500;">
                    Guardar
                </button>
            </div>
        </form>
    </div>
</div>