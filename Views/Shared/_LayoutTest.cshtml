    <style>
            /* ==========================================================================
                                                                           1. VARIABLES GLOBALES (Modificá toda la estructura base desde aquí)
                                                                           NOTA: ¡NO pongas !important en estos valores!
                                                                           ========================================================================== */
            :root {
                /* --- FUENTES Y TAMAÑOS --- */
                --tamanio-fuente-general: 0.75rem;
                --tamanio-iconos-principales: 0.75rem;
                --tamanio-iconos-guion: 0.75rem;
                /* --- MÁRGENES Y ALINEACIONES HORIZONTALES --- */
                --margen-nivel-1: 0px;
                --margen-nivel-2: 0px;
                --margen-nivel-3: 0px;
                /* --- ESPACIADOS Y TAMAÑOS DE BOTONES (ALINEACIÓN VERTICAL) --- */
                --espaciado-vertical-items: 5px;
                --interlineado-texto: 1.5;
                /* --- COLORES Y ESTILOS VISUALES --- */
                --color-texto-menu: #ffffff;
                --color-fondo-hover: rgba(255, 255, 255, 0.08);
                --color-fondo-activo: rgba(255, 255, 255, 0.15);
                --radio-bordes: 4px;
                /* --- ANIMACIONES --- */
                --velocidad-animacion: 0.3s;
            }

            /* ==========================================================================
                                                                           2. CONTENEDOR PRINCIPAL DEL MENÚ LATERAL
                                                                           ========================================================================== */
            .menu-lateral {
                min-width: 200px !important;
                width: 220px !important;
                font-size: var(--tamanio-fuente-general) !important;
            }

                /* ==========================================================================
                                                                           3. LIMPIEZA DE VIÑETAS Y LISTAS
                                                                           ========================================================================== */
                .menu-lateral ul,
                .menu-lateral li {
                    list-style: none !important;
                    list-style-type: none !important;
                    padding: 0 !important;
                    margin: 0 !important;
                }

            /* ==========================================================================
                                                                           4. ESTILOS BASE DE TODOS LOS BOTONES Y ENLACES
                                                                           ========================================================================== */
            .menu-lista .menu-item button,
            .menu-lista .menu-item a {
                padding-left: var(--margen-nivel-1) !important;
                padding-top: var(--espaciado-vertical-items) !important;
                padding-bottom: var(--espaciado-vertical-items) !important;
                text-align: left !important;
                display: block !important;
                width: 100% !important;
                color: inherit !important;
                text-decoration: none !important;
                border: none !important;
                background: transparent !important;
                cursor: pointer !important;
                transition: background-color 0.2s ease !important;
                font-size: var(--tamanio-fuente-general) !important;
            }

            .menu-titulo {
                display: flex !important;
                align-items: center !important;
            }

                .menu-titulo i {
                    font-size: var(--tamanio-iconos-principales) !important;
                    margin-right: 10px !important;
                }

            .menu-lista .menu-item button:hover,
            .menu-lista .menu-item a:hover {
                background-color: var(--color-fondo-hover) !important;
                border-radius: var(--radio-bordes) !important;
            }

            /* ==========================================================================
                                                                           5. SUBMENÚ PRINCIPAL (Nivel 2)
                                                                           ========================================================================== */
            .submenu {
                overflow: hidden !important;
                max-height: 0;
                transition: max-height var(--velocidad-animacion) ease !important;
                padding-left: var(--margen-nivel-2) !important;
            }

                .submenu.visible {
                    max-height: 800px !important;
                }

            /* ==========================================================================
                                                                           6. SUBMENÚ EXTRA (Nivel 3)
                                                                           ========================================================================== */
            .submenu-extra {
                display: none !important;
                flex-direction: column !important;
                margin-left: var(--margen-nivel-3) !important;
                opacity: 0;
                transform: translateX(-10px);
                transition: all 0.25s ease !important;
            }

                .submenu-extra.visible {
                    display: flex !important;
                    opacity: 1 !important;
                    transform: translateX(0) !important;
                }

                .submenu-extra a {
                    display: block !important;
                    position: relative !important;
                    padding-left: 10px !important;
                    line-height: var(--interlineado-texto) !important;
                    color: inherit !important;
                }

                    /* ==========================================================================
                                                                                   7. ESTADOS ACTIVOS
                                                                                   ========================================================================== */
                    .submenu a.active,
                    .submenu-extra a.active {
                        background-color: var(--color-fondo-activo) !important;
                        border-radius: var(--radio-bordes) !important;
                        font-weight: 500 !important;
                    }

            /* ==========================================================================
                                                                           8. ÍCONO GUIÓN
                                                                           ========================================================================== */
            .icon-guion {
                font-size: var(--tamanio-iconos-guion) !important;
                margin-right: 6px !important;
                vertical-align: middle !important;
            }

            /* ==========================================================================
                                                                           9. LOGO BAXEN
                                                                           ========================================================================== */
            .menu-logo {
                text-align: center !important;
                padding: 20px 10px !important;
            }

                .menu-logo img {
                    width: 80px !important;
                    max-width: 100% !important;
                    height: auto !important;
                }

            /* ==========================================================================
                                                                           10. ANULAR ÍCONOS/CUADRADOS GLOBALES SOLO EN ESTE MENÚ
                                                                           ========================================================================== */
            #menuLateral .submenu-extra a::before {
                display: none !important;
                content: "" !important;
            }

            /* ==========================================================================
                                                           FORZAR INDENTACIÓN DE NIVELES (Prioridad Máxima con ID)
                                                       ========================================================================== */

            /* NIVEL 1 (Ej: Información básica, Tareas) */
            #menuLateral .menu-lista > .menu-item > .menu-titulo,
            #menuLateral .menu-lista > .menu-item > a {
                padding-left: 10px !important;
            }

            /* NIVEL 2 (Ej: Recepción, Proceso materiales, Entregas...) */
            #menuLateral .submenu > li > .menu-titulo,
            #menuLateral .submenu > li > .submenu-btn,
            #menuLateral .submenu > li > a {
                padding-left: 15px !important;
            }

            /* NIVEL 3 (Ej: Proceso de lavado, Control de instrumental...) */
            #menuLateral .submenu > li.submenu-extra > a {
                padding-left: 35px !important;
            }

            /* ==========================================================================
                                               NIVEL 4: COMPORTAMIENTO Y SANGRÍA (Lavado, Esterilización, etc.)
                                            ========================================================================== */

            /* 1. Ocultar la lista por defecto */
            #menuLateral .submenu > li.submenu-extra > ul {
                display: none !important;
                flex-direction: column !important;
                margin: 0 !important;
                padding: 0 !important;
            }

                /* 2. Mostrar la lista cuando hacemos clic (se agrega la clase desde JS) */
                #menuLateral .submenu > li.submenu-extra > ul.visible {
                    display: flex !important;
                }

                /* 3. Empujar los textos a la derecha (El famoso requerimiento original) */
                #menuLateral .submenu > li.submenu-extra > ul > li > a {
                    padding-left: 55px !important; /* Ajustá este valor si los querés más o menos a la derecha */
                }

                /* Clase para mostrar el Nivel 4 cuando se hace clic */
                #menuLateral .submenu > li.submenu-extra > ul.visible {
                    display: flex !important;
                }
    </style>
</head>

<body>

    <script>
                document.addEventListener("DOMContentLoaded", function () {

                /* --- BÚSQUEDAS EN NUEVA PESTAÑA --- */
                document.querySelectorAll(".link-busqueda").forEach(link => {
                    link.addEventListener("click", function (e) {
                        e.preventDefault();

                        const url = this.getAttribute("href");

                        if (url && url !== "#") {
                            window.open(url, "_blank");
                        }
                    });
                });

                    /* --- SUBMENÚS PRINCIPALES --- */
                    const botones = document.querySelectorAll(".toggle-submenu");
                    const submenus = document.querySelectorAll(".submenu");

                    botones.forEach(boton => {
                        boton.addEventListener("click", function () {
                            const submenu = this.nextElementSibling;

                            // 1. Cerramos los otros menús principales y reseteamos su interior
                            submenus.forEach(sm => {
                                if (sm !== submenu) {
                                    sm.classList.remove("visible");
                                    // Limpiamos cualquier subnivel (Nivel 3 y 4) que haya quedado abierto
                                    sm.querySelectorAll(".visible").forEach(hijoVisible => {
                                        hijoVisible.classList.remove("visible");
                                    });
                                }
                            });

                            // 2. Abrimos/Cerramos el menú principal actual
                            submenu.classList.toggle("visible");

                            // 3. Si el usuario está colapsando el menú actual, reseteamos su interior también
                            if (!submenu.classList.contains("visible")) {
                                submenu.querySelectorAll(".visible").forEach(hijoVisible => {
                                    hijoVisible.classList.remove("visible");
                                });
                            }

                            // 4. Limpieza de sombreados activos
                            document.querySelectorAll(".menu-item").forEach(mi => mi.classList.remove("active"));
                            this.closest(".menu-item").classList.add("active");

                            document.querySelectorAll(".submenu a, .submenu-extra a, .submenu-extra > ul > li > a")
                                .forEach(l => l.classList.remove("active"));
                        });
                    });

                    

                    /* --- SUBMENÚS EXTENDIDOS (solo uno abierto a la vez) --- */
                            /* --- SUBMENÚS EXTENDIDOS --- */

                            function activarSubmenuExtendido(selector) {
                                document.querySelectorAll(selector).forEach(link => {
                                    link.addEventListener("click", function (e) {
                                        e.preventDefault();

                                        const extra = this.parentElement.nextElementSibling;

                                        if (!extra || !extra.classList.contains("submenu-extra")) return;

                                        document.querySelectorAll(".submenu-extra.visible").forEach(open => {
                                            if (open !== extra) open.classList.remove("visible");
                                        });

                                        extra.classList.toggle("visible");
                                    });
                                });
                            }
                    

            // Inicialización
            // 1. Agrupamos los selectores
                const selectoresToggle = [
                    ".submenu a[href='/ProcesoMateriales']",
                    ".submenu a[href='/Entregas']",
                    "#btnIdentificar",
                    "#btnBusquedaRecepciones",
                    "#btnBusquedaProcesoMateriales",
                    "#btnEstProcesosMateriales",
                    "#btnBusquedaEntregas",
                    "#btnBusquedaTransito",
                    "#btnBusquedaStock"
                ];

                /* --- GATILLO PARA ABRIR/CERRAR NIVEL 4 --- */
                    document.querySelectorAll(".submenu-extra > a").forEach(link => {
                        link.addEventListener("click", function (e) {
                            const ulNivel4 = this.nextElementSibling;

                            // Si el enlace tiene una lista abajo (Nivel 4), lo desplegamos
                            if (ulNivel4 && ulNivel4.tagName === "UL") {
                                e.preventDefault();
                                ulNivel4.classList.toggle("visible");
                            }
                        });
                    });

            // Activamos la función para cada uno
            selectoresToggle.forEach(selector => activarSubmenuExtendido(selector));

                    /* --- RESALTAR ÍTEMS INTERNOS Y AUTO-CERRAR MENÚ --- */
                    // Sumamos los enlaces del Nivel 4 para que se puedan resaltar (.submenu-extra > ul > li > a)
                    const menuLinks = document.querySelectorAll(".submenu a, .submenu-extra a, .submenu-extra > ul > li > a");

                    menuLinks.forEach(link => {
                        link.addEventListener("click", function () {

                            /* 1. Comportamiento de resaltado activo */
                            menuLinks.forEach(l => l.classList.remove("active"));
                            this.classList.add("active");
                            document.querySelectorAll(".menu-item").forEach(mi => mi.classList.remove("active"));

                            /* 2. Comportamiento de Auto-Cierre */
                            // Detectamos si es un botón abridor O si tiene un Nivel 4 colgando al lado
                            const esAbridorDeMenu = selectoresToggle.some(selector => this.matches(selector)) ||
                                                    (this.nextElementSibling && this.nextElementSibling.tagName === "UL");

                            if (!esAbridorDeMenu) {
                                // Cerramos todos los niveles abiertos si es un enlace final
                                document.querySelectorAll(".submenu.visible, .submenu-extra.visible, .submenu-extra > ul.visible").forEach(menuAbierto => {
                                    menuAbierto.classList.remove("visible");
                                });
                                document.querySelectorAll(".menu-item.active").forEach(mi => mi.classList.remove("active"));
                            }
                        });
                    });


                    /* --- SALIR DEL SISTEMA --- */
                    const btnSalir = document.getElementById("btnSalir");
                    if (btnSalir) btnSalir.addEventListener("click", () => window.close());

                                const btnReusosAsignar = document.getElementById("btnReusosAsignar");
                // llama a modal debugger reuso

                    if (btnReusosAsignar) {
                    btnReusosAsignar.addEventListener("click", function (e) {
                        e.preventDefault();

                        fetch("/Reusos/ModalBuscarReuso")
                            .then(response => response.text())
                            .then(html => {
                                const contenedor = document.getElementById("contenedorModalReuso");
                                contenedor.innerHTML = html;

                                const modal = document.getElementById("modalBuscarReuso");
                                modal.style.display = "flex";

                             // 🔥 FOCO AUTOMÁTICO
                                setTimeout(() => {
                                    const input = document.getElementById("txtBuscarCodigoReuso");
                                    if (input) {
                                        input.focus();
                                        input.select();
                                    }
                                }, 100);

                                const btnCerrar = document.getElementById("btnCerrarModalReuso");

                                if (btnCerrar) {
                                    btnCerrar.addEventListener("click", function () {
                                        modal.style.display = "none";
                                    });
                                }

                                // para ingresar codigo reuso

                                const btnBuscar = document.getElementById("btnBuscarCodigoReuso");
                                const txtCodigo = document.getElementById("txtBuscarCodigoReuso");
                                const msg = document.getElementById("msgBuscarReuso");

                                if (txtCodigo && btnBuscar) {
                                            txtCodigo.addEventListener("keydown", function (e) {
                                                if (e.key === "Enter") {
                                                    e.preventDefault();
                                                    btnBuscar.click();
                                                }
                                            });
                                        }

                                if (btnBuscar) {
                                    btnBuscar.addEventListener("click", function () {
                                        const codigo = txtCodigo.value.trim();

                                        msg.style.display = "none";
                                        msg.textContent = "";

                                        if (!codigo) {
                                            msg.textContent = "Ingrese un código.";
                                            msg.style.display = "block";
                                            txtCodigo.focus();
                                            return;
                                        }

                                    fetch(`/Reusos/ValidarCodigoReusoDisponible?codigo=${encodeURIComponent(codigo)}`)
                                                .then(response => response.json())
                                                .then(data => {
                                                    if (!data.success || !data.disponible) {
                                                        msg.textContent = data.mensaje || "Código no disponible.";
                                                        msg.style.display = "block";
                                                        txtCodigo.focus();
                                                        return;
                                                    }

                                                    modal.style.display = "none";

                                                    // guardamos el código de reuso
                                                    localStorage.setItem("codigoReuso", data.codigo);

                                                    // seteamos destino como hacen los otros módulos
                                                    localStorage.setItem(
                                                                "loginDestino",
                                                                `/Reusos/CrearReusos?codigo=${encodeURIComponent(data.codigo)}`
                                                            );

                                                    // abrimos el login REAL de tu sistema
                                                    const modalLogin = new bootstrap.Modal(document.getElementById('loginTareasModal'));
                                                    modalLogin.show();
                                                })
                                                .catch(() => {
                                                    msg.textContent = "Error al validar el código.";
                                                    msg.style.display = "block";
                                                });
                                    });
                                }

                           

                            });
                    });
                }
                });
    </script>

