﻿@{
Layout = null;
}


<!DOCTYPE html>
<html lang="es">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Baxen® Trazabilidad</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/estilos.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/img/BAXEN - Logo.ico" />
    <link rel="stylesheet" href="~/css/modal-control-proceso.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
            /* --- ANCHO DEL MENÚ --- */
            .menu-lateral {
                min-width: 270px !important;
                width: 270px !important;
            }

            /* Alineación uniforme */
            .menu-lista .menu-item button,
            .menu-lista .menu-item a {
                padding-left: 18px !important;
            }

            /* Submenú adicional */
            .submenu-extra {
                display: none;
                flex-direction: column;
                margin-left: 22px;
                opacity: 0;
                transform: translateX(-10px);
                transition: all 0.25s ease;
            }

                .submenu-extra.visible {
                    display: flex;
                    opacity: 1;
                    transform: translateX(0);
                }

                /* CUADRADO ▪ más grande y centrado */
                .submenu-extra a {
                    display: block !important;
                    position: relative;
                    padding-left: 24px !important;
                    line-height: 1.7;
                    color: inherit !important;
                }

                    .submenu-extra a::before {
                        content: "▪";
                        position: absolute;
                        left: 0;
                        top: 1px;
                        font-size: 25px;
                        color: inherit;
                    }

                    /* Ítem activo dentro del submenú */
                    .submenu a.active,
                    .submenu-extra a.active {
                        background-color: rgba(255,255,255,0.12);
                        border-radius: 4px;
                    }

            /* Animación del submenú principal */
            .submenu {
                overflow: hidden;
                max-height: 0;
                transition: max-height 0.3s ease;
            }

                .submenu.visible {
                    max-height: 800px;
                }

            .icon-guion {
                font-size: 1.2rem;
                margin-right: 6px;
                vertical-align: middle;
            }

            .icon-cuadro {
                font-size: 0.55rem;
                margin-right: 8px;
                vertical-align: middle;
            }
    </style>
</head>

<body>

    <script>
            document.addEventListener("DOMContentLoaded", function () {

            /* --- BÚSQUEDAS EN NUEVA PESTAÑA --- */
            document.querySelectorAll(".link-busqueda").forEach(link => {
                link.addEventListener("click", function (e) {
                    e.preventDefault();

                    const url = this.getAttribute("href");

                    if (url && url !== "#") {
                        window.open(url, "_blank");
                    }
                });
            });

                /* --- SUBMENÚS PRINCIPALES --- */
                const botones = document.querySelectorAll(".toggle-submenu");
                const submenus = document.querySelectorAll(".submenu");

                botones.forEach(boton => {
                    boton.addEventListener("click", function () {
                        const submenu = this.nextElementSibling;

                        submenus.forEach(sm => {
                            if (sm !== submenu) sm.classList.remove("visible");
                        });

                        submenu.classList.toggle("visible");

                        /* Marcar título activo */
                        document.querySelectorAll(".menu-item").forEach(mi => mi.classList.remove("active"));
                        this.closest(".menu-item").classList.add("active");

                        /* Quitar active de ítems internos */
                        document.querySelectorAll(".submenu a, .submenu-extra a")
                            .forEach(l => l.classList.remove("active"));
                    });
                });

                /* --- SUBMENÚS EXTENDIDOS (solo uno abierto a la vez) --- */
                function activarSubmenuExtendido(selector) {
                    document.querySelectorAll(selector).forEach(link => {
                        link.addEventListener("click", function (e) {
                            e.preventDefault();

                            const extra = this.parentElement.nextElementSibling;

                            if (!extra || !extra.classList.contains("submenu-extra")) return;

                            document.querySelectorAll(".submenu-extra.visible").forEach(open => {
                                if (open !== extra) open.classList.remove("visible");
                            });

                            extra.classList.toggle("visible");
                        });
                    });
                }

                activarSubmenuExtendido(".submenu a[href='/ProcesoMateriales']");
                activarSubmenuExtendido(".submenu a[href='/Entregas']");
                activarSubmenuExtendido("#btnIdentificar");
                activarSubmenuExtendido("#btnBusquedaRecepciones");
                activarSubmenuExtendido("#btnProcesoEsterilizacion");
                activarSubmenuExtendido("#btnBusquedaLavado");
                activarSubmenuExtendido("#btnProcesoEsterilizacion");
                activarSubmenuExtendido("#btnBusquedaProcesoMateriales");

                /* --- RESALTAR ÍTEMS INTERNOS --- */
                const menuLinks = document.querySelectorAll(".submenu a, .submenu-extra a");

                menuLinks.forEach(link => {
                    link.addEventListener("click", function () {

                        /* Quitar active de todos los enlaces */
                        menuLinks.forEach(l => l.classList.remove("active"));

                        /* Agregar active al clickeado */
                        this.classList.add("active");

                        /* Quitar active de los títulos principales */
                        document.querySelectorAll(".menu-item").forEach(mi => mi.classList.remove("active"));
                    });
                });

                /* --- SALIR DEL SISTEMA --- */
                const btnSalir = document.getElementById("btnSalir");
                if (btnSalir) btnSalir.addEventListener("click", () => window.close());

                            const btnReusosAsignar = document.getElementById("btnReusosAsignar");
            // llama a modal debugger reuso

                if (btnReusosAsignar) {
                btnReusosAsignar.addEventListener("click", function (e) {
                    e.preventDefault();

                    fetch("/Reusos/ModalBuscarReuso")
                        .then(response => response.text())
                        .then(html => {
                            const contenedor = document.getElementById("contenedorModalReuso");
                            contenedor.innerHTML = html;

                            const modal = document.getElementById("modalBuscarReuso");
                            modal.style.display = "flex";

                         // 🔥 FOCO AUTOMÁTICO
                            setTimeout(() => {
                                const input = document.getElementById("txtBuscarCodigoReuso");
                                if (input) {
                                    input.focus();
                                    input.select();
                                }
                            }, 100);

                            const btnCerrar = document.getElementById("btnCerrarModalReuso");

                            if (btnCerrar) {
                                btnCerrar.addEventListener("click", function () {
                                    modal.style.display = "none";
                                });
                            }

                            // para ingresar codigo reuso

                            const btnBuscar = document.getElementById("btnBuscarCodigoReuso");
                            const txtCodigo = document.getElementById("txtBuscarCodigoReuso");
                            const msg = document.getElementById("msgBuscarReuso");

                            if (txtCodigo && btnBuscar) {
                                        txtCodigo.addEventListener("keydown", function (e) {
                                            if (e.key === "Enter") {
                                                e.preventDefault();
                                                btnBuscar.click();
                                            }
                                        });
                                    }

                            if (btnBuscar) {
                                btnBuscar.addEventListener("click", function () {
                                    const codigo = txtCodigo.value.trim();

                                    msg.style.display = "none";
                                    msg.textContent = "";

                                    if (!codigo) {
                                        msg.textContent = "Ingrese un código.";
                                        msg.style.display = "block";
                                        txtCodigo.focus();
                                        return;
                                    }

                                fetch(`/Reusos/ValidarCodigoReusoDisponible?codigo=${encodeURIComponent(codigo)}`)
                                            .then(response => response.json())
                                            .then(data => {
                                                if (!data.success || !data.disponible) {
                                                    msg.textContent = data.mensaje || "Código no disponible.";
                                                    msg.style.display = "block";
                                                    txtCodigo.focus();
                                                    return;
                                                }

                                                modal.style.display = "none";

                                                // guardamos el código de reuso
                                                localStorage.setItem("codigoReuso", data.codigo);

                                                // seteamos destino como hacen los otros módulos
                                                localStorage.setItem(
                                                            "loginDestino",
                                                            `/Reusos/CrearReusos?codigo=${encodeURIComponent(data.codigo)}`
                                                        );

                                                // abrimos el login REAL de tu sistema
                                                const modalLogin = new bootstrap.Modal(document.getElementById('loginTareasModal'));
                                                modalLogin.show();
                                            })
                                            .catch(() => {
                                                msg.textContent = "Error al validar el código.";
                                                msg.style.display = "block";
                                            });
                                });
                            }

                           

                        });
                });
            }
            });
    </script>

    <aside class="menu-lateral" id="menuLateral">

        <div class="menu-logo">
            <img src="~/img/BAXEN - Logo.png" alt="Baxen® Trazabilidad">
        </div>

        <ul class="menu-lista">

            <li class="menu-item">
                <button type="button" class="menu-titulo toggle-submenu">
                    <i class="bi bi-collection"></i> Información básica
                </button>
                <ul class="submenu">
                    <li><a href="/IB_Equipos/IB_Equipos"><i class="bi bi-dash icon-guion"></i> Equipos</a></li>
                    <li><a href="/Materiales/ListaMateriales"><i class="bi bi-dash icon-guion"></i> Productos médicos</a></li>
                    <li><a href="/Instrumental"><i class="bi bi-dash icon-guion"></i> Instrumental</a></li>
                    <li><a href="/IBPersonal/IBPersonalListado"><i class="bi bi-dash icon-guion"></i> Personal</a></li>
                    <li><a href="/IBProveedor/IBProveedor"><i class="bi bi-dash icon-guion"></i> Proveedores</a></li>
                    <li><a href="/IBProfesional/IBProfesional"><i class="bi bi-dash icon-guion"></i> Profesionales</a></li>
                    <li><a href="/IBSector/IBSector"><i class="bi bi-dash icon-guion"></i> Sectores</a></li>
                </ul>
            </li>

            <li class="menu-item">
                <button type="button" class="menu-titulo toggle-submenu">
                    <i class="bi bi-list-check"></i> Tareas
                </button>
                <ul class="submenu">

                    <li><a href="#" id="btnRecepcion"><i class="bi bi-dash icon-guion"></i> Recepción</a></li>

                    <li><a href="/ProcesoMateriales"><i class="bi bi-dash icon-guion"></i> Proceso de materiales</a></li>
                    <li class="submenu-extra">
                        <a href="#" id="btnLavado">Proceso de lavado</a>
                        <a href="/ControlInstrumental">Control de instrumental</a>
                        <a href="#" id="btnAcondicionado">Registro acondicionado</a>
                        <a href="#" id="btnProcesos">Proceso esterilización</a>
                        <a href="/RegistroDesinfeccion">Registro desinfección</a>
                    </li>

                    <li><a href="/Entregas"><i class="bi bi-dash icon-guion"></i> Entregas</a></li>
                    <li class="submenu-extra">
                        <a href="#" id="btnEntrega">Entregas a sectores</a>
                        <a href="/CarroQuirurgico">Preparar carro</a>
                        <a href="/PanelSalas">Panel salas quirúrgicas</a>
                        <a href="/BuscarProcedimientos">Buscar procedimientos</a>
                    </li>
                    <li><a href="#" id="btnIdentificar"><i class="bi bi-dash icon-guion"></i> Identificar materiales</a></li>
                    <li class="submenu-extra">
                        <a href="/Trazabilidad">Producción</a>
                        <a href="/Reusos">Generar código de reúso</a>
                        <a href="#" id="btnReusosAsignar">Asignar código de reúso</a>
                        <a href="/Reusos">Baja código de reúso</a>
                        <a href="/Reusos">Liberar código de reúso</a>
                    </li>
                    <li><a href="/Transito"><i class="bi bi-dash icon-guion"></i> Instrumental en tránsito</a></li>
                    <li><a href="/Stock"><i class="bi bi-dash icon-guion"></i> Transacciones de stock</a></li>
                </ul>
            </li>

            <li class="menu-item">
                <button type="button" class="menu-titulo toggle-submenu">
                    <i class="bi bi-search"></i> Búsqueda de datos
                </button>
                <ul class="submenu">
                    
                    
                    <li><a href="#" id="btnBusquedaRecepciones"><i class="bi bi-dash icon-guion"></i> Recepciones</a></li>

                    <li class="submenu-extra">
                        <a href="/BusRec/Index" class="link-busqueda">Búsqueda recepciones</a>
                        <a href="/RecDetBusqueda/Index" class="link-busqueda">Búsqueda materiales recibidos</a>
                    </li>
                    
                    <li><a href="#" id="btnBusquedaProcesoMateriales"><i class="bi bi-dash icon-guion"></i> Proceso de materiales</a></li>

                    <li class="submenu-extra">
                        <a href="#" id="btnBusquedaLavado">Lavado</a>

                        <ul>
                            <li>
                                <a href="/BusLavado/IndexLav" class="link-busqueda">Búsqueda lavado</a>
                            </li>

                            <li>
                                <a href="/BusLavadoDet/IndexLavDet" class="link-busqueda">Búsqueda materiales lavados</a>
                            </li>
                        </ul>

                        <a href="/BusAco/IndexAcondicionado" class="link-busqueda">Acondicionado</a>

                        <a href="#">Control de instrumental</a>

                        <a href="#" id="btnProcesoEsterilizacion">Proceso esterilización</a>

                        <ul>
                            <li>
                                <a href="/BusPro/IndexProcesos" class="link-busqueda">Búsqueda procesos</a>
                            </li>

                            <li>
                                <a href="/BusProDet/IndexProDet" class="link-busqueda">Búsqueda materiales procesados</a>
                            </li>
                        </ul>

                        <a href="#">Registro desinfección</a>
                    </li>
                    <li><a href="/Entregas"><i class="bi bi-dash icon-guion"></i> Entregas</a></li>
                    <li><a href="/ControlPM"><i class="bi bi-dash icon-guion"></i> Control productos médicos</a></li>
                    <li><a href="/Transito"><i class="bi bi-dash icon-guion"></i> Instrumental en tránsito</a></li>
                    <li><a href="/Stock"><i class="bi bi-dash icon-guion"></i> Stock</a></li>
                    <li><a href="/Clientes"><i class="bi bi-dash icon-guion"></i> Búsqueda de datos cliente</a></li>
                </ul>
            </li>

            <li class="menu-item">
                <button type="button" class="menu-titulo toggle-submenu">
                    <i class="bi bi-qr-code"></i> Trazabilidad
                </button>
                <ul class="submenu">
                    <li><a href="#">(Opciones futuras)</a></li>
                </ul>
            </li>

            <li class="menu-item">
                <button type="button" class="menu-titulo toggle-submenu">
                    <i class="bi bi-bar-chart"></i> Estadísticas
                </button>
                <ul class="submenu">
                    <li><a href="#">(Opciones futuras)</a></li>
                </ul>
            </li>

            <li class="menu-item">
                <button type="button" class="menu-titulo toggle-submenu">
                    <i class="bi bi-gear"></i> Área de sistemas
                </button>
                <ul class="submenu">
                    <li><a href="#">(Opciones futuras)</a></li>
                </ul>
            </li>

            <li class="menu-item">
                <button type="button" class="menu-titulo" id="btnSalir">
                    <i class="bi bi-box-arrow-right"></i> Salir del sistema
                </button>
            </li>

        </ul>
    </aside>

    <nav class="navbar-principal">
        <div class="titulo-navbar">@ViewData["Title"]</div>
    </nav>

    <div class="breadcrumbs">
        @RenderSection("Breadcrumbs", required: false)
    </div>

    <main class="contenido">
        @RenderBody()
    </main>

    <partial name="_LoginModal" />
    <div id="contenedorModalReuso"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/login.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>