@model IEnumerable<ConexionSql.Models.SP_Busquedas.BusRecDetDto>
@{
    ViewData["Title"] = "Búsqueda de Materiales - Baxen";
}

<link rel="stylesheet" href="~/css/busquedas-custom.css" />

<div class="contenedor-titulo">
    <h1 class="titulo-derecha">Búsqueda de Materiales</h1>
</div>

<div class="panel-filtros">
    <form id="formBusquedaRecDet">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label>ID ETIQUETA (CET)</label>
                    <input type="number" name="BUS_CET" id="BUS_CET" class="form-control campo-activo" placeholder="ID Exacto">
                </div>
                <div class="form-group">
                    <label>FECHA INICIO</label>
                    <input type="date" name="BUS_FEC_INI" id="BUS_FEC_INI" class="form-control" value="@ViewBag.FEC_INI">
                </div>
                <div class="form-group">
                    <label>FECHA FIN</label>
                    <input type="date" name="BUS_FEC_FIN" id="BUS_FEC_FIN" class="form-control" value="@ViewBag.FEC_FIN">
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label>DENOMINACIÓN / MATERIAL</label>
                    <input type="text" name="BUS_DEN" class="form-control" placeholder="LIKE%">
                </div>
                <div class="form-group">
                    <label>PACIENTE</label>
                    <input type="text" name="BUS_PAC" class="form-control" placeholder="Apellido/Nombre">
                </div>
                <div class="form-group">
                    <label>PROFESIONAL</label>
                    <input type="text" name="BUS_PRO" class="form-control">
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label>SECTOR ORIGEN</label>
                    <input type="text" name="BUS_SEC_ORI" class="form-control">
                </div>
                <div class="form-group">
                    <label>ESTADO</label>
                    <input type="text" name="BUS_EST" class="form-control">
                </div>
                <div class="custom-control custom-checkbox mt-2">
                    <input type="checkbox" name="BUS_ACAJ_OPC" value="true" class="custom-control-input" id="acaj">
                    <label class="custom-control-label" for="acaj" style="font-size: 0.75rem; color: #7f8c8d;">A CAJA</label>
                </div>
            </div>

            <div class="col-md-3">
                <div class="menu-operaciones">
                    <button type="button" class="btn-menu" id="btnBuscar">
                        <span class="material-icons">search</span> BUSCAR
                    </button>
                    <button type="button" class="btn-menu" onclick="location.reload()">
                        <span class="material-icons">refresh</span> LIMPIAR
                    </button>

                    <div class="reporte-container">
                        <button type="button" class="btn-menu" id="btnReporte">
                            <span class="material-icons">description</span> REPORTES
                        </button>
                        <div class="opciones-reporte">
                            <button type="button" class="btn-menu btn-pdf">
                                <span class="material-icons">picture_as_pdf</span> PDF
                            </button>
                            <button type="button" class="btn-menu btn-excel">
                                <span class="material-icons">table_view</span> EXCEL
                            </button>
                        </div>
                    </div>
                </div>

                <div class="badge-contador-grande">
                    Resultados: <span id="lblContador">0</span>
                </div>
            </div>
        </div>
    </form>
</div>

<div id="zonaResultados">
    <div id="loader" style="display:none;">
        <div class="brand-text">Baxen® Trazabilidad</div>
        <div class="spinner"></div>
        <div class="loading-text">Procesando búsqueda...</div>
    </div>

    <div id="divResultadosRecDet">
        <div style="padding: 40px; text-align: center; color: #bdc3c7;">
            <span class="material-icons" style="font-size: 48px;">inventory</span>
            <p>Seleccione los filtros y presione Buscar para ver materiales.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#btnBuscar").click(function () {
                const formData = $("#formBusquedaRecDet").serialize();

                // Mostrar loader Baxen
                $("#loader").css("display", "flex");
                $("#divResultadosRecDet").css("opacity", "0.5");

                $.ajax({
                    url: '@Url.Action("Buscar", "BusRecDet")',
                    type: 'POST',
                    data: formData,
                    success: function (result) {
                        $("#loader").hide();
                        $("#divResultadosRecDet").css("opacity", "1");
                        $("#divResultadosRecDet").html(result);
                    },
                    error: function () {
                        $("#loader").hide();
                        $("#divResultadosRecDet").css("opacity", "1");
                        alert("Error en la conexión con el servidor.");
                    }
                });
            });
        });
    </script>
}