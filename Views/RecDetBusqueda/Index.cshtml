@model List<ConexionSql.Models.SP_Busquedas.RecDetBusquedaDto>

<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
<link rel="stylesheet" href="~/css/busquedas-custom.css" />
<link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">

<style>
    .panel-filtros {
        height: 270px !important;
        padding: 15px 25px !important;
        margin-bottom: 10px !important;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
    }

    #zonaResultados {
        display: block !important;
        width: 100% !important;
        height: auto !important;
        min-height: 100px;
        max-height: 1000px;
        overflow: auto !important;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        background: #fff;
        margin-top: 10px;
        padding: 20px;
    }

    .table-estadistica {
        width: 100% !important;
        border-collapse: separate;
        border-spacing: 0;
        table-layout: auto;
    }

        .table-estadistica thead th {
            position: sticky !important;
            top: 0 !important;
            background-color: #2c3e50 !important;
            color: #ffffff !important;
            z-index: 10;
            padding: 8px 12px;
            font-size: 0.85rem !important;
            border: 1px solid #3e4f5f !important;
            white-space: nowrap;
            text-align: center;
        }

        .table-estadistica tbody td {
            padding: 4px 12px !important;
            font-size: 0.8rem !important;
            color: #2c3e50 !important;
            border: 1px solid #dee2e6 !important;
            white-space: nowrap;
        }

        .table-estadistica tbody tr:nth-child(even) {
            background-color: #e9ecef !important;
        }

    .border-right-strong {
        border-right: 3px solid #2c3e50 !important;
    }

    .border-left-strong {
        border-left: 3px solid #2c3e50 !important;
    }

    /* Estilo para resaltar campos con valor */
    .form-control.con-valor {
        border-color: #2980b9 !important;
        background-color: #f0f7fc !important;
        box-shadow: 0 0 0 0.2rem rgba(41, 128, 185, 0.25) !important;
    }

    /* Estilos Autocompletado */
    .autocomplete-list {
        position: absolute;
        z-index: 1000;
        background: white;
        border: 1px solid #ddd;
        width: 90%;
        max-height: 180px;
        overflow-y: auto;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .autocomplete-list li {
            padding: 8px 12px;
            cursor: pointer;
            font-size: 0.85rem;
        }

            .autocomplete-list li:hover, .autocomplete-list li.selected {
                background-color: #2980b9 !important;
                color: white !important;
            }
</style>

<div class="contenedor-titulo"><h1 class="titulo-derecha">Búsqueda de materiales recibidos</h1></div>

<div class="panel-filtros">
    <div class="row" style="display: flex; flex-wrap: wrap;">
        @* Bloque 1 *@
        <div class="col-md-2">
            <div class="form-group"><label>Fecha Inicio</label><input type="date" id="BUS_FEC_INI" class="form-control" value="@ViewBag.FEC_INI" /></div>
            <div class="form-group"><label>Fecha Fin</label><input type="date" id="BUS_FEC_FIN" class="form-control" value="@ViewBag.FEC_FIN" /></div>
            <div class="form-group"><label>Código Etiqueta</label><input type="text" id="BUS_CET" class="form-control" /></div>
            <div class="text-left"><span id="contador" class="badge-contador-grande" style="display:none;"></span></div>
        </div>

        @* Bloque 2 *@
        <div class="col-md-3">
            <div class="form-group"><label>Denominación</label><input type="text" id="BUS_DEN" class="form-control autocompletar" data-tabla="IB_MAT" data-campo="IB_MAT_DEN" autocomplete="off" /></div>
            <div class="form-group"><label>Código Producto</label><input type="text" id="BUS_MAT_PR" class="form-control autocompletar" data-tabla="IB_MAT" data-campo="IB_MAT_PR" autocomplete="off" /></div>
            <div class="form-group"><label>Código Reúso</label><input type="text" id="BUS_REU_ID" class="form-control autocompletar" data-tabla="TB_REU" data-campo="TB_REU_ID_FORM" autocomplete="off" /></div>
        </div>

        @* Bloque 3 *@
        <div class="col-md-2">
            <div class="form-group"><label>Sector Origen</label><input type="text" id="BUS_SEC_ORI" class="form-control autocompletar" data-tabla="IB_SEC" data-campo="IB_SEC_DEN" autocomplete="off" /></div>
            <div class="form-group"><label>Sector Destino</label><input type="text" id="BUS_SEC_DES" class="form-control autocompletar" data-tabla="IB_SEC" data-campo="IB_SEC_DEN" autocomplete="off" /></div>
            <div class="form-group"><label>Estado</label><input type="text" id="BUS_EST" class="form-control autocompletar" data-tabla="IB_MAT_EST_ING" data-campo="IB_MAT_EST_ING_DEN" autocomplete="off" /></div>
        </div>

        @* Bloque 4 *@
        <div class="col-md-3">
            <div class="form-group"><label>Paciente</label><input type="text" id="BUS_PAC" class="form-control autocompletar" data-tabla="TB_REC_DET" data-campo="TB_REC_DET_PAC" autocomplete="off" /></div>
            <div class="form-group"><label>Profesional</label><input type="text" id="BUS_PRO" class="form-control autocompletar" data-tabla="IB_PRO" data-campo="IB_PRO_APE" autocomplete="off" /></div>
            <div class="form-group"><label>Proveedor</label><input type="text" id="BUS_ORT_DEN" class="form-control autocompletar" data-tabla="IB_ORT" data-campo="IB_ORT_DEN" autocomplete="off" /></div>
            <div class="row">
                <div class="col-md-6"><label>Remito</label><input type="text" id="BUS_REM" class="form-control autocompletar" data-tabla="TB_REC_DET" data-campo="TB_REC_DET_REM" autocomplete="off" /></div>
                <div class="col-md-6"><label>Fecha Procedimiento</label><input type="date" id="BUS_FEN" class="form-control" /></div>
            </div>
        </div>

        @* Bloque 5 *@
        <div class="col-md-2 col-operaciones-container">
            <div class="menu-operaciones">
                <button id="btnBuscar" class="btn-menu" onclick="Buscar()"><span class="material-icons">search</span> Buscar</button>
                <button id="btnReporte" class="btn-menu" onclick="Reporte()"><span class="material-icons">description</span> Reporte</button>
                <button class="btn-menu" onclick="Limpiar()"><span class="material-icons">cleaning_services</span> Limpiar</button>
                <button class="btn-menu" onclick="location.href='@Url.Action("Index", "Home")'"><span class="material-icons">logout</span> Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div id="zonaResultados-wrapper" style="position:relative;">
    <div id="loader">
        <span style="margin-bottom: 10px; font-weight: normal; color: #2c3e50; font-size: 1.2em;">Baxen® Trazabilidad</span>
        <div class="spinner"></div>
        <span style="margin-top: 20px; color: #555; font-style: italic;">Buscando información solicitada...</span>
    </div>
    <div id="zonaResultados">@Html.Partial("_ResultadosRecDet", Model)</div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <script>
        $(document).ready(function () {
            $(document).on('input change', '.form-control', function() {
                $(this).val() ? $(this).addClass('campo-activo') : $(this).removeClass('campo-activo');
            }).trigger('change');

            $(".autocompletar").each(function() {
                var $el = $(this);
                $el.autocomplete({
                    source: function (request, response) {
                        $.getJSON('@Url.Action("GetSugerencias", "RecDetBusqueda")', {
                            term: request.term,
                            campo: $el.data('campo'),
                            tabla: $el.data('tabla')
                        }, response);
                    },
                    minLength: 2
                });
            });
            Buscar();
        });

        function Buscar() {
            var datos = {
                BUS_CET: $.trim($('#BUS_CET').val()),
                BUS_FEC_INI: $('#BUS_FEC_INI').val(),
                BUS_FEC_FIN: $('#BUS_FEC_FIN').val(),
                BUS_DEN: $.trim($('#BUS_DEN').val()),
                BUS_SEC_ORI: $.trim($('#BUS_SEC_ORI').val()),
                BUS_SEC_DES: $.trim($('#BUS_SEC_DES').val()),
                BUS_EST: $.trim($('#BUS_EST').val()),
                BUS_MAT_PR: $.trim($('#BUS_MAT_PR').val()),
                BUS_ORT_DEN: $.trim($('#BUS_ORT_DEN').val()),
                BUS_PAC: $.trim($('#BUS_PAC').val()),
                BUS_PRO: $.trim($('#BUS_PRO').val()),
                BUS_REM: $.trim($('#BUS_REM').val()),
                BUS_REU_ID: $.trim($('#BUS_REU_ID').val()),
                BUS_FEN: $('#BUS_FEN').val()
            };

            $.ajax({
                url: '@Url.Action("Buscar", "RecDetBusqueda")',
                type: 'POST',
                data: datos,
                timeout: 30000,
                beforeSend: function() { $('#loader').css('display', 'flex'); },
                success: function (html) {
                    $('#zonaResultados').html(html);
                    var num = $('#zonaResultados tbody tr').length;
                    $('#contador').html("Registros: " + num).show();
                },
                error: function (xmlhttprequest, textstatus, message) {
                    if (textstatus === "timeout") alert("Tiempo de espera agotado.");
                    else console.error("Error en la búsqueda");
                },
                complete: function() { $('#loader').hide(); }
            });
        }

        function Reporte() { alert("Generando reporte..."); }

        function Limpiar() {
            $('.form-control').val('').removeClass('campo-activo');
            $('#BUS_FEC_INI').val('@ViewBag.FEC_INI');
            $('#BUS_FEC_FIN').val('@ViewBag.FEC_FIN');
            $('#contador').hide();
            Buscar();
        }
    </script>
}