@model IEnumerable<ConexionSql.Models.SP_Busquedas.BusProDto>

@if (Model != null && Model.Any())
{
    <table>
        <thead>
            <tr>
                <th>Proceso</th>
                <th>Lote</th>
                <th>Fecha / Hora</th>
                <th>Tipo de proceso</th>
                <th>Equipo</th>
                <th>Tipo de ciclo</th>
                <th>Estado</th>
                @* <th>Usuario</th>
                <th>Acción</th> *@
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    @* <td>@item.TB_PRO_ID</td> *@
                    <td ondblclick="window.location.href='/TbProBusqueda/VerProceso?tbProId=@item.TB_PRO_ID'"
                        style="cursor:pointer;">
                        @item.TB_PRO_ID
                    </td>
                    <td>@item.TB_PRO_NUM_1</td>
                    @* <td>@item.TB_PRO_FEC</td> *@
                    <td>@item.TB_PRO_HOR_INI</td>
                    <td>@item.TB_PRO_PTI_DEN</td>
                    <td>@item.EQUIPO</td>
                    <td>@item.TB_PRO_TCI_DEN</td>
                    <td>@item.IB_PRO_EST_DEN</td>
                    @* <td>@item.TB_PRO_UPRO</td> *@
                    @* <td>
                        <button onclick="verDetalleProceso(@item.TB_PRO_ID)">
                            Ver Detalle
                        </button>
                    </td> *@
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div>
        No se encontraron procesos que coincidan con los filtros aplicados.
    </div>
}

<script>
    function verDetalleProceso(tbProId) {
        window.location.href = '/TbProBusqueda/VerProceso?tbProId=' + tbProId;
    }
</script>

