@model IEnumerable<ConexionSql.Models.SP_Busquedas.BusProDetDto>

@if (Model != null && Model.Any())
{
    <div id="zonaResultados" style="max-height: 350px; overflow: auto; width: 100%; border: 1px solid #dee2e6; border-radius: 8px; background: #fff;">
        <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
            <thead>
                <tr>
                    <th style="position: sticky; top: 0; background-color: #2c3e50; color: #ffffff; z-index: 10; padding: 12px; white-space: nowrap; border-bottom: 2px solid #1a252f;">
                        Código etiqueta
                    </th>
                    <th style="position: sticky; top: 0; background-color: #2c3e50; color: #ffffff; z-index: 10; padding: 12px; white-space: nowrap; border-bottom: 2px solid #1a252f;">
                        Denominación
                    </th>
                    <th style="position: sticky; top: 0; background-color: #2c3e50; color: #ffffff; z-index: 10; padding: 12px; white-space: nowrap; border-bottom: 2px solid #1a252f;">
                        Cantidad
                    </th>
                    <th style="position: sticky; top: 0; background-color: #2c3e50; color: #ffffff; z-index: 10; padding: 12px; white-space: nowrap; border-bottom: 2px solid #1a252f;">
                        Sector Destino
                    </th>
                    <th style="position: sticky; top: 0; background-color: #2c3e50; color: #ffffff; z-index: 10; padding: 12px; white-space: nowrap; border-bottom: 2px solid #1a252f;">
                        Equipo / Proceso
                    </th>
                    <th style="position: sticky; top: 0; background-color: #2c3e50; color: #ffffff; z-index: 10; padding: 12px; white-space: nowrap; border-bottom: 2px solid #1a252f;">
                        Fecha / Hora
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td ondblclick="window.location.href='/Traza/TrazaRecDetID/@item.TB_PRO_DET_REC_DET_ID'" style="cursor: pointer; white-space: nowrap; font-weight: normal; color: #1a252f;">
                            @item.TB_PRO_DET_REC_DET_ID
                        </td>
                        <td style="white-space: nowrap;">@item.TB_PRO_DET_REC_DET_MAT_DEN</td>
                        <td style="white-space: nowrap;">@item.TB_PRO_DET_CANT</td>
                        <td style="white-space: nowrap;">@item.TB_REC_SEC_DES_DEN</td>
                        <td style="white-space: nowrap;">@item.EQUIPO</td>
                        <td style="white-space: nowrap;">@item.TB_PRO_HOR_INI hs</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div style="padding: 25px; text-align: center; color: #7f8c8d; font-size: 0.85rem; background: #fff; border: 1px solid #dee2e6; border-radius: 8px;">
        No hay detalles de procesos activos que coincidan con los filtros seleccionados.
    </div>
}

 
