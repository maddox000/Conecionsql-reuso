@model List<ConexionSql.Models.SP_Busquedas.BusLavadoDto>

@if (Model != null && Model.Any())
{
    <table class="table-baxen-estilo">
        <thead>
            <tr>
                <th>Proceso</th>
                <th>Lote</th>
                <th>Fecha</th>
                <th>Tipo de proceso</th>
                <th>Equipo</th>
                <th>Número equipo</th>
                <th>Estado proceso</th>
                
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.TB_PRO_LAV_ID</td>
                    <td style="font-weight: normal;">@item.TB_PRO_LAV_NUM</td>
                    <td>@item.TB_PRO_LAV_FEC.ToString("dd/MM/yyyy")</td>
                    <td>@item.TB_PRO_LAV_PTI_DEN</td>
                    <td>@item.TB_PRO_IB_EQU_TEQ_DEN</td>
                    <td>@item.TB_PRO_LAV_EQU_NUM</td>
                    @* Estado como texto simple, igual al resto *@
                    <td>@item.TB_PRO_LAV_EST_DEN</td>
                    @* Acción como botón simple de icono, sin recuadros extra *@
                    
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info" style="background-color: #d1f2eb; color: #1abc9c; border: none; padding: 20px; margin-top: 0px !important; width: 100% !important; border-radius: 0 !important;">
        Utilice los filtros para iniciar la búsqueda.
    </div>
}